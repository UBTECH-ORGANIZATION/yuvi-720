        <mxCell id="t-n-plat" parent="11" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#52606D" value="No long-lived credential anywhere: the workload authenticates to Key Vault, the database, Service Bus and the registry with a managed identity, and the pipeline authenticates with federated credentials rather than a stored secret." vertex="1">
          <mxGeometry height="46" width="820" x="345" y="1122" as="geometry" />
