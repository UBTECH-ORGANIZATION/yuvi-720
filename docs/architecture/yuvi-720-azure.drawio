        <mxCell id="t-n-split" parent="11" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#52606D" value="Split so a thirty-second rendering job never shares a process with a child waiting on a streamed answer. Both replicas are genuinely stateless — which is only true once sessions and the event bus move to Redis." vertex="1">
