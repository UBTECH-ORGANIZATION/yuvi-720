        <mxCell id="t-wkr" parent="11" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2933;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/other/Worker_Container_App.svg;" value="spark-workers&lt;br&gt;KEDA · queue depth, scale to zero" vertex="1">
