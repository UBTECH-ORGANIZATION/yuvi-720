        <mxCell id="t-n-fb" parent="11" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#52606D" value="The file fallback stops being a production path: a database failure fails the request and raises an alert, instead of writing to local disk where nobody sees it." vertex="1">
          <mxGeometry height="40" width="820" x="345" y="812" as="geometry" />
        </mxCell>
        <mxCell id="t-n-redis" parent="11" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#6B46C1" value="&lt;b&gt;This is the box that unlocks the one above it.&lt;/b&gt; Everything that pins the app to a single worker today is a module-level dict: the SSE subscriber map in &lt;i&gt;realtime.py&lt;/i&gt;, learner presence and its offline timers, the trigger cooldowns that stop the coach nudging twice for the same mistake, and the per-teacher alert sequence counters. Redis replaces all four — pub/sub for the bus, keys with TTL for presence and cooldowns, INCR for the counters. &lt;i&gt;server.py&lt;/i&gt; prints a warning at boot when WEB_CONCURRENCY &amp;gt; 1; this is what makes that warning unnecessary." vertex="1"><mxGeometry height="86" width="820" x="345" y="856" as="geometry" /></mxCell>
        <mxCell id="t-e19" edge="1" parent="11" source="t-wkr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B46C1;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;exitX=0;exitY=0.75;entryX=1;entryY=0.5" target="t-redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="483" /><mxPoint x="600" y="732" /></Array></mxGeometry></mxCell>
        <mxCell id="t-kv" parent="11" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2933;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Key_Vaults.svg;" value="Key Vault" vertex="1">
