        <mxCell id="c-n-net" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#52606D" value="The Ministry LRS allow-lists a single egress IP, so all LRS traffic is routed through the firewall and leaves as 104.41.217.81. Only the LRS /32 goes through the tunnel — developers reach the same path over the Entra-authenticated gateway without tunnelling anything else." vertex="1">
          <mxGeometry height="80" width="545" x="345" y="945" as="geometry" />
        </mxCell>
        <mxCell id="c-n-admin" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#52606D" value="Separate App Service and separate image. Google sign-in with an e-mail allow-list; reads the AI usage table read-only for cost reporting. Never exposed from the learner app." vertex="1">
          <mxGeometry height="130" width="206" x="942" y="905" as="geometry" />
        </mxCell>
        <mxCell id="c-n-kata" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#52606D" value="Catalogue and xAPI launcher. Relays every content statement back to our ingest endpoint, so a wrong public URL silently drops all learning evidence — reachability is probed at boot." vertex="1">
          <mxGeometry height="80" width="350" x="1580" y="320" as="geometry" />
        </mxCell>
        <mxCell id="c-n-lrs" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#52606D" value="OAuth. Outbox ledger with retry and de-duplication on the same statement id; reporting is fire-and-forget and never blocks a learner feature." vertex="1">
          <mxGeometry height="70" width="350" x="1580" y="560" as="geometry" />
