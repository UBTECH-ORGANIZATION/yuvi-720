        <mxCell id="t-api" parent="11" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2933;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/other/Container_App_Environments.svg;" value="spark-api&lt;br&gt;KEDA · HTTP concurrency" vertex="1">
