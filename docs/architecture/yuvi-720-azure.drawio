          <mxGeometry height="64" width="64" x="1343" y="830" as="geometry" />
        </mxCell>
        <mxCell id="t-fw" parent="11" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2933;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Firewalls.svg;" value="✓ Azure Firewall&lt;br&gt;LRS egress, unchanged" vertex="1">
          <mxGeometry height="64" width="64" x="1343" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="t-users" parent="11" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2933;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Users.svg;" value="Learners · Teachers" vertex="1">
          <mxGeometry height="64" width="64" x="106" y="250" as="geometry" />
        </mxCell>
        <mxCell id="t-gh" parent="11" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2933;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Builds.svg;" value="GitHub Actions" vertex="1">
          <mxGeometry height="64" width="64" x="106" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="t-n-gh" parent="11" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#6B46C1" value="Test gate first, then build, then deploy, then a health poll before promotion. Federated credentials replace the stored service-principal secret." vertex="1">
          <mxGeometry height="110" width="200" x="40" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="t-kata" parent="11" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2933;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Globe.svg;" value="Kata / CET" vertex="1">
          <mxGeometry height="64" width="64" x="1610" y="200" as="geometry" />
        </mxCell>
        <mxCell id="t-lrs" parent="11" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2933;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Globe.svg;" value="Ministry LRS" vertex="1">
          <mxGeometry height="64" width="64" x="1610" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="t-order" parent="11" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;fontSize=11;fontColor=#1F2933" value="&lt;b&gt;Order I would do it in&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1 · Test gate in the pipeline.&lt;/b&gt; An afternoon. The tests exist and pass; the pattern already exists in the admin service. The largest risk reduction per hour of work on this page.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · Managed Content Safety.&lt;/b&gt; The users are children. What runs today is a solid first-party base layer — deterministic redaction, an LLM disclosure classifier, an LLM memory guardian — not a substitute for input and output filtering with jailbreak shields.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Key Vault, managed identity, federated pipeline credentials.&lt;/b&gt; Removes every long-lived secret.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 · Redis.&lt;/b&gt; Until sessions, presence and the event bus leave process memory, the service physically cannot run a second replica. Everything about scale is blocked behind this one change.&lt;br&gt;&lt;br&gt;&lt;b&gt;5 · Service Bus and the worker split.&lt;/b&gt; Gets rendering and ministry reporting off the request path.&lt;br&gt;&lt;br&gt;&lt;b&gt;6 · Container Apps with KEDA.&lt;/b&gt; Only worth doing after 4 and 5 — autoscaling a service that cannot run two replicas buys nothing.&lt;br&gt;&lt;br&gt;&lt;b&gt;7 · Retry with backoff at the gateway&lt;/b&gt;, so a transient provider failure stops degrading silently into a canned sentence.&lt;br&gt;&lt;br&gt;&lt;b&gt;8 · Front Door.&lt;/b&gt; Real, but the least urgent: it is a performance and hardening win, not a correctness or safety one.&lt;br&gt;&lt;br&gt;&lt;b&gt;Deliberately absent:&lt;/b&gt; a vector database. The content is a structured catalogue with stable identifiers, so retrieval is an id lookup. Embeddings would add a moving part and lose precision." vertex="1">
          <mxGeometry height="1130" width="120" x="1830" y="110" as="geometry" />
        </mxCell>
        <mxCell id="t-e1" edge="1" parent="11" source="t-users" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4B5A69;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#3E4C59;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5" target="t-fd" value="HTTPS · SSE">
