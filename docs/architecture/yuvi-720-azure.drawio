        <mxCell id="t-acr" parent="11" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#1F2933;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/containers/Container_Registries.svg;" value="✓ Container Registry" vertex="1">
