t="cur-sb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="136" y="800"/><mxPoint x="1056" y="800"/></Array></mxGeometry></mxCell><mxCell id="cur-27" value="KEDA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D0762F;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#8A4416;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cur-sb" target="cur-ggp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cur-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#93A0AD;strokeWidth=1.4;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#67737F;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cur-app" target="cur-mongo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cur-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#93A0AD;strokeWidth=1.4;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#67737F;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cur-app" target="cur-redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="152" y="830"/><mxPoint x="592" y="830"/></Array></mxGeometry></mxCell><mxCell id="cur-30" value="route-all" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A4FCB;strokeWidth=2.2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#5B32A8;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cur-plan" target="cur-udr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="58" y="760"/><mxPoint x="58" y="1160"/><mxPoint x="316" y="1160"/></Array></mxGeometry></mxCell><mxCell id="cur-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A4FCB;strokeWidth=2.2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#5B32A8;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cur-udr" target="cur-fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cur-32" value="SNAT to the ministry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A4FCB;strokeWidth=2.2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#5B32A8;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cur-fw" target="cur-ext"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1795" y="1256"/><mxPoint x="1795" y="470"/><mxPoint x="2280" y="470"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2 · Production · two spokes, no hub" id="prod"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prod-10" value="Production · rg-spark-prod · Israel Central" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#17212B" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="44" as="geometry"/></mxCell><mxCell id="prod-11" value="Two virtual networks: the application spoke that owns the cluster and its two public addresses, the data spoke that owns the private endpoints. Every service the endpoints front is drawn beside its endpoint. The numbered badges follow one request from a learner’s browser to the model and back." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#67737F" vertex="1" parent="1"><mxGeometry x="40" y="74" width="2600" height="40" as="geometry"/></mxCell><mxCell id="prod-clients" value="Who connects" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FBFBFC;strokeColor=#98A2AE;dashed=1;fontColor=#5C6875;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="480" height="240" as="geometry"/></mxCell><mxCell id="prod-users" value="Learners&lt;br&gt;teachers" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="70" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-staff" value="Yuvilab&lt;br&gt;staff" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="175" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-kata" value="Kata / CET&lt;br&gt;content + xAPI" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Globe.svg;" vertex="1" parent="1"><mxGeometry x="280" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-moe" value="MoE OIDC" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="385" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-moelrs" value="MoE LRS" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Globe.svg;" vertex="1" parent="1"><mxGeometry x="70" y="275" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-google" value="Google&lt;br&gt;staff sign-in" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="175" y="275" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-gha" value="GitHub Actions&lt;br&gt;OIDC, no secrets" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Builds.svg;" vertex="1" parent="1"><mxGeometry x="280" y="275" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-12" value="Kata relays xAPI; GitHub pushes images and runs deploys." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="385" y="282" width="125" height="80" as="geometry"/></mxCell><mxCell id="prod-edge" value="Global edge · afd-spark · Front Door Premium · the only WAF, closest to the client · four Static Web Apps behind it" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FAF7FF;strokeColor=#8B6FD0;dashed=1;fontColor=#6237B8;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="1440" height="240" as="geometry"/></mxCell><mxCell id="prod-fd" value="Front Door&lt;br&gt;Premium" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Front_Doors.svg;" vertex="1" parent="1"><mxGeometry x="600" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-waf" value="WAF policy&lt;br&gt;OWASP + bot + rate" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Web_Application_Firewall_Policies_WAF.svg;" vertex="1" parent="1"><mxGeometry x="710" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-dns" value="DNS zone&lt;br&gt;yuvilab.ai" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="820" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-swaweb" value="swa-spark-web&lt;br&gt;Standard · $9/mo" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/preview/Static_Apps.svg;" vertex="1" parent="1"><mxGeometry x="950" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-swaadmin" value="swa-spark-admin" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/preview/Static_Apps.svg;" vertex="1" parent="1"><mxGeometry x="1075" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-swasupport" value="swa-spark-support" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/preview/Static_Apps.svg;" vertex="1" parent="1"><mxGeometry x="1200" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-swalrs" value="swa-spark-lrs" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/preview/Static_Apps.svg;" vertex="1" parent="1"><mxGeometry x="1325" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-routes" value="spark.yuvilab.ai&lt;br&gt;&amp;nbsp;&amp;nbsp;/&amp;nbsp;&amp;nbsp;/student/*&amp;nbsp;&amp;nbsp;/teacher/*&amp;nbsp;&amp;nbsp;&amp;nbsp;swa-spark-web&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;SPA&amp;nbsp;fallback&amp;nbsp;routing&amp;nbsp;is&amp;nbsp;native&lt;br&gt;&amp;nbsp;&amp;nbsp;/api/*&amp;nbsp;&amp;nbsp;/ws/*&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;origin-prod.spark&amp;nbsp;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;ingress,&amp;nbsp;over&amp;nbsp;TLS&lt;br&gt;&amp;nbsp;&amp;nbsp;admin.&amp;nbsp;/&amp;nbsp;support.&amp;nbsp;/&amp;nbsp;lrs.&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;swa-spark-{admin,support,lrs};&amp;nbsp;their&amp;nbsp;/api/*&amp;nbsp;→&amp;nbsp;ingress" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#CFDAE3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontFamily=Courier New;fontColor=#243642;" vertex="1" parent="1"><mxGeometry x="1460" y="168" width="520" height="108" as="geometry"/></mxCell><mxCell id="prod-13" value="Each Static Web App accepts traffic only from this profile: allowedIpRanges = AzureFrontDoor.Backend and a required X-Azure-FDID header in staticwebapp.config.json. The containers stop serving files; /landing, /locales, /shared and the Game Lab player move into the SWA build. Unity bundles and media stay on Blob behind the same edge." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="600" y="290" width="1380" height="70" as="geometry"/></mxCell><mxCell id="prod-we" value="West Europe · the model path stays where Cognitive Services exist · plus the operators’ door" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FBFBFC;strokeColor=#98A2AE;dashed=1;fontColor=#5C6875;" vertex="1" parent="1"><mxGeometry x="2040" y="130" width="1220" height="240" as="geometry"/></mxCell><mxCell id="prod-apim" value="apim-cotrade-prod&lt;br&gt;UNCHANGED" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/API_Management_Services.svg;" vertex="1" parent="1"><mxGeometry x="2080" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-aoai" value="Azure OpenAI × 5&lt;br&gt;priority failover" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="1"><mxGeometry x="2225" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-foundry" value="gpt-image&lt;br&gt;foundry-poland" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Cognitive_Services.svg;" vertex="1" parent="1"><mxGeometry x="2370" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-cs" value="Content Safety" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Content_Safety.svg;" vertex="1" parent="1"><mxGeometry x="2515" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-lang" value="Language · PII" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Language_Services.svg;" vertex="1" parent="1"><mxGeometry x="2660" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-speech" value="Speech" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Speech_Services.svg;" vertex="1" parent="1"><mxGeometry x="2805" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-vpn" value="vpng-yuvi-we&lt;br&gt;P2S · Entra · exists" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="2990" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-14" value="APIM keeps its own policy and we do not touch it. The existing point-to-site gateway earns its keep: peered globally to the spokes, it is how an operator reaches the private API server and the database endpoints — no Bastion, no jump box." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="2080" y="290" width="1160" height="70" as="geometry"/></mxCell><mxCell id="prod-rg" value="Israel Central · availability zones 1, 2 and 3 · one resource group for the workload, plus rg-spark-shared for the registry and the DNS zones" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F4FAF7;strokeColor=#107C4B;dashed=1;dashPattern=8 4;fontSize=16;fontColor=#0B6B3F;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="3220" height="1760" as="geometry"/></mxCell><mxCell id="prod-vnetapp" value="vnet-app-prod · 10.61.0.0/16 · rg-spark-prod · Azure CNI Overlay, pods on 10.244.0.0/16 · Cilium dataplane, network policy on · no route tables: the NAT gateway is a subnet association, not a route" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#2F6FB5;strokeWidth=2.5;fontColor=#1F4F86;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="2100" height="1710" as="geometry"/></mxCell><mxCell id="prod-edgeband" value="At the edge of the network — two public addresses, neither of them reachable by a person" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F4F9FE;strokeColor=#3D8BD4;dashed=1;rounded=1;arcSize=3;fontSize=12;fontColor=#12456E;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="2040" height="130" as="geometry"/></mxCell><mxCell id="prod-nat" value="nat-spark-prod&lt;br&gt;StandardV2 · zone-redundant" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/NAT.svg;" vertex="1" parent="1"><mxGeometry x="110" y="550" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-natpip" value="pip-nat-prod&lt;br&gt;the fixed egress address" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Public_IP_Addresses.svg;" vertex="1" parent="1"><mxGeometry x="270" y="550" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-15" value="Egress on the left, ingress on the right, and they never meet. The NAT gateway is attached to both node subnets and SNATs everything outbound to one address — 64k ports per IP, no route table, and inbound flows through the load balancer return the way they came, which is the asymmetric-routing trap a hub firewall would have forced us to solve with an Application Gateway. The ingress address is public on paper only: the NSG rule AKS writes for it admits the AzureFrontDoor.Backend tag and nothing else, and spark-core drops any request whose X-Azure-FDID is not our profile." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="430" y="545" width="1250" height="78" as="geometry"/></mxCell><mxCell id="prod-ingress" value="ingress-nginx" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;shadow=0;strokeWidth=1;fillColor=#2875E2;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=ing;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#26343F;" vertex="1" parent="1"><mxGeometry x="1740" y="552" width="42" height="42" as="geometry"/></mxCell><mxCell id="prod-ilb" value="lb-ingress&lt;br&gt;Standard LB · zone-redundant" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Load_Balancers.svg;" vertex="1" parent="1"><mxGeometry x="1900" y="550" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-ingpip" value="pip-ingress-prod&lt;br&gt;AzureFrontDoor.Backend only" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Public_IP_Addresses.svg;" vertex="1" parent="1"><mxGeometry x="2060" y="550" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-snapi" value="snet-apiserver · 10.61.2.0/28 · delegated to Microsoft.ContainerService/managedClusters" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FAFCFE;strokeColor=#A8BECE;fontSize=12;fontColor=#4D6275;" vertex="1" parent="1"><mxGeometry x="100" y="670" width="2040" height="105" as="geometry"/></mxCell><mxCell id="prod-aks" value="aks-spark-prod&lt;br&gt;Standard tier · zones 1-3" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/containers/Kubernetes_Services.svg;" vertex="1" parent="1"><mxGeometry x="140" y="695" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-16" value="API Server VNet Integration: the control plane is projected here behind an internal VIP, the public FQDN resolves to that private address, Entra RBAC with local accounts off. Reached by the nodes, by operators over the VPN peering, and by GitHub through az aks command invoke — which runs kubectl inside the cluster, so no runner ever needs a network path. Kubernetes 1.36, Azure Linux 3 nodes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="300" y="692" width="1820" height="72" as="geometry"/></mxCell><mxCell id="prod-snsys" value="snet-aks-system · 10.61.4.0/24 · nsg-aks-nodes · NAT gateway attached" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FAFCFE;strokeColor=#A8BECE;fontSize=12;fontColor=#4D6275;" vertex="1" parent="1"><mxGeometry x="100" y="795" width="2040" height="150" as="geometry"/></mxCell><mxCell id="prod-nsgnodes" value="nsg-aks-nodes&lt;br&gt;443 from AzureFrontDoor.Backend" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="1"><mxGeometry x="140" y="825" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-syspool" value="pool system&lt;br&gt;3 × D2as_v5 · zones 1-3" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/VM_Scale_Sets.svg;" vertex="1" parent="1"><mxGeometry x="320" y="825" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-17" value="Taint CriticalAddonsOnly, so nothing of ours schedules here. It runs the platform: CoreDNS, metrics-server, KEDA, the workload-identity webhook, the Key Vault CSI driver, the ingress controller, cert-manager for the origin certificate, the Container Insights agent, the Policy sensor, Cilium. outboundType userAssignedNATGateway: every packet that leaves a node is SNATed to pip-nat, and the ministry allowlists exactly that address." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="500" y="822" width="1620" height="110" as="geometry"/></mxCell><mxCell id="prod-snusr" value="snet-aks-user · 10.61.8.0/22 · nsg-aks-nodes · NAT gateway attached · three pools with distinct taints, one subnet" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FAFCFE;strokeColor=#A8BECE;fontSize=12;fontColor=#4D6275;" vertex="1" parent="1"><mxGeometry x="100" y="965" width="2040" height="1180" as="geometry"/></mxCell><mxCell id="prod-pool-npapp" value="pool npapp · D4as_v5 · 3 → 6 · zones 1, 2 and 3 · nodeSelector spark.io/pool=app · everything a browser is waiting on: identity, product and staff" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#EEF4FA;strokeColor=#5B8FC4;strokeWidth=1.5;rounded=1;arcSize=3;fontSize=12;fontColor=#1F4F86;" vertex="1" parent="1"><mxGeometry x="100" y="1005" width="2040" height="555" as="geometry"/></mxCell><mxCell id="prod-authtier" value="Identity tier — one service issues the learner and teacher session; every other service only verifies it" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFBF0;strokeColor=#B7791F;strokeWidth=2;rounded=1;arcSize=3;fontSize=12;fontColor=#8A5A0B;" vertex="1" parent="1"><mxGeometry x="120" y="1045" width="2000" height="140" as="geometry"/></mxCell><mxCell id="prod-auth" value="&lt;b&gt;auth-api&lt;/b&gt;&lt;br&gt;/api/auth/*&lt;br&gt;password sign-in (Argon2id) · MoE OIDC start and callback&lt;br&gt;issues the ES256 session · refresh · logout · role resolution&lt;br&gt;2 → 4 replicas · sa-auth → id-auth-prod" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=8;fontSize=11;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="140" y="1077" width="640" height="98" as="geometry"/></mxCell><mxCell id="prod-authicon" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;shadow=0;strokeWidth=1;fillColor=#B7791F;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=deploy;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#26343F;" vertex="1" parent="1"><mxGeometry x="439" y="1085" width="40" height="40" as="geometry"/></mxCell><mxCell id="prod-authnote1" value="It issues, it does not proxy. No request passes through auth on its way somewhere else: auth mints a signed session and every other service verifies that signature inside its own process." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#B6C2CE;rounded=1;arcSize=4;fontSize=11;fontStyle=0;fontColor=#3E4C59;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="800" y="1077" width="640" height="98" as="geometry"/></mxCell><mxCell id="prod-authnote2" value="Only auth holds the private key. Everyone else fetches the public half from JWKS once and caches it. Only auth writes users, sessions and the revocation list, so a compromised lane cannot mint a session." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#B6C2CE;rounded=1;arcSize=4;fontSize=11;fontStyle=0;fontColor=#3E4C59;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1460" y="1077" width="640" height="98" as="geometry"/></mxCell><mxCell id="prod-lanetier" value="Product tier — reached by a learner or teacher browser · all three build on spark-core: the credential factory, session verification, the X-Azure-FDID check, the event publisher, the Mongo and Redis clients, telemetry and the PII scrub" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F7FAFD;strokeColor=#9FB8CE;rounded=1;arcSize=3;fontSize=12;fontColor=#3A5670;" vertex="1" parent="1"><mxGeometry x="120" y="1200" width="2000" height="165" as="geometry"/></mxCell><mxCell id="prod-student" value="&lt;b&gt;student-api&lt;/b&gt;&lt;br&gt;/api/student/* · /api/xapi/*&lt;br&gt;coach SSE · xAPI ingest from Kata · mastery fold&lt;br&gt;safety gate · games API · presence&lt;br&gt;2 → 8 replicas · sa-student → id-student-prod" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FA0BE;align=center;verticalAlign=bottom;spacingBottom=8;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="140" y="1235" width="640" height="120" as="geometry"/></mxCell><mxCell id="prod-studenti" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;shadow=0;strokeWidth=1;fillColor=#2875E2;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=deploy;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#26343F;" vertex="1" parent="1"><mxGeometry x="440" y="1244" width="40" height="40" as="geometry"/></mxCell><mxCell id="prod-teacher" value="&lt;b&gt;teacher-api&lt;/b&gt;&lt;br&gt;/api/teacher/*&lt;br&gt;roster · insights · wellbeing · mentoring&lt;br&gt;assistant SSE · live strip&lt;br&gt;2 → 6 replicas · sa-teacher → id-teacher-prod" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FA0BE;align=center;verticalAlign=bottom;spacingBottom=8;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="800" y="1235" width="640" height="120" as="geometry"/></mxCell><mxCell id="prod-teacheri" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;shadow=0;strokeWidth=1;fillColor=#2875E2;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=deploy;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#26343F;" vertex="1" parent="1"><mxGeometry x="1100" y="1244" width="40" height="40" as="geometry"/></mxCell><mxCell id="prod-support" value="&lt;b&gt;support-api&lt;/b&gt;&lt;br&gt;/api/support/* · /ws/support&lt;br&gt;the widget opens a WebSocket here · DOM stream ·&lt;br&gt;WebRTC signalling · Redis pub/sub joins the replicas&lt;br&gt;2 → 6 replicas · sa-support → id-support-prod" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FA0BE;align=center;verticalAlign=bottom;spacingBottom=8;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1460" y="1235" width="640" height="120" as="geometry"/></mxCell><mxCell id="prod-supporti" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;shadow=0;strokeWidth=1;fillColor=#2875E2;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=deploy;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#26343F;" vertex="1" parent="1"><mxGeometry x="1760" y="1244" width="40" height="40" as="geometry"/></mxCell><mxCell id="prod-stafftier" value="Staff tier — API only now that the three SPAs live on Static Web Apps · each ships its own sign-in today and auth-api is what collapses them · the LRS portal cannot be IP-restricted, ministry people sign in there too" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F2FAFA;strokeColor=#0F7B78;rounded=1;arcSize=3;fontSize=12;fontColor=#0A5A58;" vertex="1" parent="1"><mxGeometry x="120" y="1380" width="2000" height="160" as="geometry"/></mxCell><mxCell id="prod-admin" value="&lt;b&gt;admin-api&lt;/b&gt;&lt;br&gt;admin.spark.yuvilab.ai · /api/*&lt;br&gt;usage and cost · org console · support triage · budgets&lt;br&gt;Google OIDC, its own cookie&lt;br&gt;1 r