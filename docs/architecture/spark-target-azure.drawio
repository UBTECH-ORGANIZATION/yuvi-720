;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-pe-mongo" target="prod-mongo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-pe-redis" value="pe-redis&lt;br&gt;10.62.0.5" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="2265" y="672" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-redis" value="redis-spark-prod&lt;br&gt;Cache Standard C1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Cache_Redis.svg;" vertex="1" parent="1"><mxGeometry x="2790" y="672" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B62;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#1E6B4A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-pe-redis" target="prod-redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-pe-blob" value="pe-blob&lt;br&gt;10.62.0.6" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="2265" y="784" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-st" value="stsparkdata&lt;br&gt;games · media · attachments · archive" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="2790" y="784" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B62;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#1E6B4A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-pe-blob" target="prod-st"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-pe-keyvault" value="pe-keyvault&lt;br&gt;10.62.0.7" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="2265" y="896" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-kv" value="kv-spark-prod&lt;br&gt;CSI-mounted secrets" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="2790" y="896" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B62;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#1E6B4A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-pe-keyvault" target="prod-kv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-pe-appconfig" value="pe-appconfig&lt;br&gt;10.62.0.8" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="2265" y="1008" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-appcfg" value="appcs-spark-prod&lt;br&gt;App Configuration Standard" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/App_Configuration.svg;" vertex="1" parent="1"><mxGeometry x="2790" y="1008" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B62;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#1E6B4A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-pe-appconfig" target="prod-appcfg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-24" value="One NIC each, static addresses; network policies stay on so nsg-pe applies to endpoint traffic." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="2250" y="1088" width="410" height="44" as="geometry"/></mxCell><mxCell id="prod-25" value="&lt;b&gt;Why the services sit outside the vnet box.&lt;/b&gt; A private endpoint is a network card in our subnet with a static address. The service behind it — the Mongo cluster, the cache, the storage account, the vault, the configuration store — is Azure-managed and lives in no vnet of ours; there is nothing to draw inside. Private DNS makes each service’s normal name resolve to its endpoint from inside the vnets, so code changes nothing, and with public network access off the service cannot be reached any other way." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="2225" y="1200" width="1035" height="66" as="geometry"/></mxCell><mxCell id="prod-msgband" value="Messaging · sb-spark-prod · Service Bus Standard · public name, Entra only" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFAF4;strokeColor=#D0762F;rounded=1;arcSize=4;fontSize=12;fontColor=#8A4416;" vertex="1" parent="1"><mxGeometry x="2210" y="1285" width="1050" height="335" as="geometry"/></mxCell><mxCell id="prod-sb" value="sb-spark-prod" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Service_Bus.svg;" vertex="1" parent="1"><mxGeometry x="2250" y="1335" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-queues" value="topic&amp;nbsp;spark-events&lt;br&gt;&amp;nbsp;&amp;nbsp;sub-notify&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;notify.*&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;notify&lt;br&gt;&amp;nbsp;&amp;nbsp;sub-summaries&amp;nbsp;&amp;nbsp;&amp;nbsp;summaries.*&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;summaries&lt;br&gt;&amp;nbsp;&amp;nbsp;sub-lrs&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;xapi.*&amp;nbsp;mastery.*&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;lrs&lt;br&gt;queues&lt;br&gt;&amp;nbsp;&amp;nbsp;q-notify&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;fan-in&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;notify&lt;br&gt;&amp;nbsp;&amp;nbsp;q-task-generate&amp;nbsp;&amp;nbsp;&amp;nbsp;teacher&amp;nbsp;tasks&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tasks&lt;br&gt;&amp;nbsp;&amp;nbsp;q-manim-render&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;scenes&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;manim&lt;br&gt;&amp;nbsp;&amp;nbsp;q-summaries&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;on&amp;nbsp;demand&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;summaries&lt;br&gt;&amp;nbsp;&amp;nbsp;q-lrs-send&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;outbox&amp;nbsp;retries&amp;nbsp;&amp;nbsp;&amp;nbsp;lrs&lt;br&gt;&amp;nbsp;&amp;nbsp;q-game-jobs&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sessions&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;games" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#CFDAE3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontFamily=Courier New;fontColor=#243642;" vertex="1" parent="1"><mxGeometry x="2360" y="1325" width="500" height="215" as="geometry"/></mxCell><mxCell id="prod-26" value="&lt;b&gt;Standard, on purpose.&lt;/b&gt; A private endpoint on Service Bus needs the Premium tier — about $715 a month for one messaging unit this load would not fill until 60,000 learners. Standard answers on its public name with SAS disabled, Entra-only authentication and an IP rule that admits only the NAT address; every publisher holds Data Sender, every worker Data Receiver on exactly one queue. Premium arrives when throughput asks for it, and the endpoint comes with it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="2880" y="1325" width="360" height="280" as="geometry"/></mxCell><mxCell id="prod-opsband" value="Shared · identity · operations" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F1F9F5;strokeColor=#3D9E73;rounded=1;arcSize=4;fontSize=12;fontColor=#0B6B3F;" vertex="1" parent="1"><mxGeometry x="2210" y="1640" width="1050" height="540" as="geometry"/></mxCell><mxCell id="prod-acr" value="yuvi720acr · Standard&lt;br&gt;Entra pull and push, admin user off" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/containers/Container_Registries.svg;" vertex="1" parent="1"><mxGeometry x="2250" y="1690" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-pdns" value="5 private DNS zones&lt;br&gt;linked to every vnet" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="2500" y="1690" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-mi" value="13 user-assigned&lt;br&gt;identities" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="2750" y="1690" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-entra" value="Entra workload&lt;br&gt;identity federation" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="3000" y="1690" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-law" value="log-spark-prod + appi&lt;br&gt;Basic Logs, sampled" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="2250" y="1820" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-alerts" value="alert rules&lt;br&gt;+ TLS web tests" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Alerts.svg;" vertex="1" parent="1"><mxGeometry x="2500" y="1820" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-policy" value="Azure Policy&lt;br&gt;for AKS · free" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="1"><mxGeometry x="2750" y="1820" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-defender" value="Defender for&lt;br&gt;Containers · from 30k" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Security_Center.svg;" vertex="1" parent="1"><mxGeometry x="3000" y="1820" width="46" height="46" as="geometry"/></mxCell><mxCell id="prod-27" value="&lt;b&gt;What was dropped, and why it is not a loss.&lt;/b&gt; No hub, no firewall, no management subnet, no Bastion, no runner pool, no Application Gateway, no Monitor Private Link Scope: each guarded against something a smaller control already covers here — the NSG tag on the ingress address, the FDID check in code, private endpoints on every store, identity-only auth on the bus and the registry, Cilium network policy between pods. &lt;b&gt;Kept:&lt;/b&gt; WorkloadIdentityCredential explicitly (never DefaultAzureCredential, whose chain falls through to a developer’s az login); AZURE_CLIENT_SECRET set nowhere; Azure Policy denying privileged pods and images from any registry but yuvi720acr. &lt;b&gt;Added when the numbers say so:&lt;/b&gt; Defender for Containers ($0.0094 per vCore-hour) from 30k learners; Cilium FQDN egress policies if a compliance question ever names egress filtering — a cluster add-on, not a network appliance." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="2240" y="1950" width="990" height="220" as="geometry"/></mxCell><mxCell id="prod-legend" value="One request, end to end&lt;br&gt;&lt;br&gt;①&amp;nbsp;browser&amp;nbsp;to&amp;nbsp;Front&amp;nbsp;Door&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;TLS,&amp;nbsp;the&amp;nbsp;OWASP&amp;nbsp;set,&amp;nbsp;bot&amp;nbsp;and&amp;nbsp;rate&amp;nbsp;rules&amp;nbsp;at&amp;nbsp;the&amp;nbsp;edge.&amp;nbsp;Kata&amp;nbsp;posts&amp;nbsp;xAPI&amp;nbsp;to&amp;nbsp;the&amp;nbsp;same&amp;nbsp;profile&lt;br&gt;②&amp;nbsp;the&amp;nbsp;SPA&amp;nbsp;from&amp;nbsp;Static&amp;nbsp;Web&amp;nbsp;Apps&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;four&amp;nbsp;apps,&amp;nbsp;one&amp;nbsp;per&amp;nbsp;host;&amp;nbsp;SPA&amp;nbsp;fallback&amp;nbsp;routing&amp;nbsp;is&amp;nbsp;theirs,&amp;nbsp;not&amp;nbsp;ours;&amp;nbsp;none&amp;nbsp;answers&amp;nbsp;without&amp;nbsp;our&amp;nbsp;X-Azure-FDID&lt;br&gt;③&amp;nbsp;/api/*&amp;nbsp;to&amp;nbsp;the&amp;nbsp;ingress&amp;nbsp;address&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;one&amp;nbsp;public&amp;nbsp;IP&amp;nbsp;on&amp;nbsp;the&amp;nbsp;cluster;&amp;nbsp;its&amp;nbsp;NSG&amp;nbsp;admits&amp;nbsp;only&amp;nbsp;the&amp;nbsp;AzureFrontDoor.Backend&amp;nbsp;tag,&amp;nbsp;spark-core&amp;nbsp;rejects&amp;nbsp;a&amp;nbsp;wrong&amp;nbsp;FDID&lt;br&gt;④&amp;nbsp;the&amp;nbsp;load&amp;nbsp;balancer&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Standard,&amp;nbsp;zone-redundant,&amp;nbsp;managed&amp;nbsp;by&amp;nbsp;AKS&amp;nbsp;—&amp;nbsp;an&amp;nbsp;inbound&amp;nbsp;flow&amp;nbsp;returns&amp;nbsp;the&amp;nbsp;way&amp;nbsp;it&amp;nbsp;came,&amp;nbsp;so&amp;nbsp;no&amp;nbsp;route&amp;nbsp;table&amp;nbsp;is&amp;nbsp;needed&lt;br&gt;⑤&amp;nbsp;ingress-nginx&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the&amp;nbsp;app&amp;nbsp;routing&amp;nbsp;add-on;&amp;nbsp;host&amp;nbsp;and&amp;nbsp;path&amp;nbsp;map&amp;nbsp;held&amp;nbsp;as&amp;nbsp;Ingress&amp;nbsp;resources&amp;nbsp;in&amp;nbsp;yuvi-core;&amp;nbsp;TLS&amp;nbsp;from&amp;nbsp;cert-manager&lt;br&gt;⑥&amp;nbsp;ingress&amp;nbsp;to&amp;nbsp;auth-api&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;a&amp;nbsp;password&amp;nbsp;sign-in,&amp;nbsp;or&amp;nbsp;the&amp;nbsp;MoE&amp;nbsp;OIDC&amp;nbsp;round&amp;nbsp;trip&lt;br&gt;⑦&amp;nbsp;auth&amp;nbsp;issues&amp;nbsp;an&amp;nbsp;ES256&amp;nbsp;session&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the&amp;nbsp;lanes&amp;nbsp;cache&amp;nbsp;the&amp;nbsp;JWKS&amp;nbsp;key&amp;nbsp;and&amp;nbsp;verify&amp;nbsp;in-process;&amp;nbsp;no&amp;nbsp;call&amp;nbsp;to&amp;nbsp;auth&amp;nbsp;per&amp;nbsp;request&lt;br&gt;⑧&amp;nbsp;ingress&amp;nbsp;to&amp;nbsp;a&amp;nbsp;product&amp;nbsp;lane&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;student,&amp;nbsp;teacher,&amp;nbsp;or&amp;nbsp;the&amp;nbsp;Kata&amp;nbsp;xAPI&amp;nbsp;relay&amp;nbsp;on&amp;nbsp;a&amp;nbsp;launch&amp;nbsp;token&amp;nbsp;—&amp;nbsp;pool&amp;nbsp;npapp&lt;br&gt;⑨&amp;nbsp;ingress&amp;nbsp;to&amp;nbsp;a&amp;nbsp;staff&amp;nbsp;API&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;admin,&amp;nbsp;support,&amp;nbsp;LRS&amp;nbsp;portal&amp;nbsp;—&amp;nbsp;their&amp;nbsp;SPAs&amp;nbsp;come&amp;nbsp;from&amp;nbsp;Static&amp;nbsp;Web&amp;nbsp;Apps,&amp;nbsp;only&amp;nbsp;/api/*&amp;nbsp;reaches&amp;nbsp;here&lt;br&gt;⑩&amp;nbsp;the&amp;nbsp;lane&amp;nbsp;publishes&amp;nbsp;an&amp;nbsp;event&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Service&amp;nbsp;Bus&amp;nbsp;Standard&amp;nbsp;on&amp;nbsp;its&amp;nbsp;public&amp;nbsp;name:&amp;nbsp;SAS&amp;nbsp;off,&amp;nbsp;Entra&amp;nbsp;only,&amp;nbsp;IP&amp;nbsp;rule&amp;nbsp;=&amp;nbsp;the&amp;nbsp;NAT&amp;nbsp;address&lt;br&gt;⑪&amp;nbsp;KEDA&amp;nbsp;wakes&amp;nbsp;exactly&amp;nbsp;one&amp;nbsp;worker&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;pool&amp;nbsp;npworkers&amp;nbsp;scales&amp;nbsp;on&amp;nbsp;the&amp;nbsp;queue&amp;nbsp;that&amp;nbsp;actually&amp;nbsp;moved&lt;br&gt;⑫&amp;nbsp;lanes&amp;nbsp;and&amp;nbsp;workers&amp;nbsp;hit&amp;nbsp;the&amp;nbsp;data&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Mongo,&amp;nbsp;Redis,&amp;nbsp;Blob,&amp;nbsp;Key&amp;nbsp;Vault,&amp;nbsp;App&amp;nbsp;Configuration&amp;nbsp;—&amp;nbsp;over&amp;nbsp;the&amp;nbsp;endpoints,&amp;nbsp;across&amp;nbsp;the&amp;nbsp;direct&amp;nbsp;peering&lt;br&gt;⑬&amp;nbsp;anything&amp;nbsp;else&amp;nbsp;leaves&amp;nbsp;via&amp;nbsp;NAT&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;one&amp;nbsp;fixed&amp;nbsp;address&amp;nbsp;for&amp;nbsp;APIM&amp;nbsp;in&amp;nbsp;West&amp;nbsp;Europe&amp;nbsp;and&amp;nbsp;the&amp;nbsp;Cognitive&amp;nbsp;endpoints;&amp;nbsp;no&amp;nbsp;route&amp;nbsp;table,&amp;nbsp;no&amp;nbsp;firewall&amp;nbsp;in&amp;nbsp;the&amp;nbsp;path&lt;br&gt;⑭&amp;nbsp;and&amp;nbsp;the&amp;nbsp;four&amp;nbsp;partners&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the&amp;nbsp;ministry&amp;nbsp;LRS&amp;nbsp;(which&amp;nbsp;allowlists&amp;nbsp;that&amp;nbsp;address),&amp;nbsp;the&amp;nbsp;Kata&amp;nbsp;catalog,&amp;nbsp;ADO,&amp;nbsp;Google&lt;br&gt;⑮&amp;nbsp;an&amp;nbsp;operator&amp;nbsp;comes&amp;nbsp;over&amp;nbsp;the&amp;nbsp;VPN&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the&amp;nbsp;existing&amp;nbsp;P2S&amp;nbsp;gateway&amp;nbsp;in&amp;nbsp;West&amp;nbsp;Europe,&amp;nbsp;peered&amp;nbsp;globally&amp;nbsp;to&amp;nbsp;the&amp;nbsp;spokes,&amp;nbsp;reaches&amp;nbsp;the&amp;nbsp;private&amp;nbsp;API&amp;nbsp;server&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;a&amp;nbsp;deploy&amp;nbsp;comes&amp;nbsp;from&amp;nbsp;GitHub&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;an&amp;nbsp;OIDC&amp;nbsp;token&amp;nbsp;pushes&amp;nbsp;the&amp;nbsp;image&amp;nbsp;to&amp;nbsp;the&amp;nbsp;registry;&amp;nbsp;az&amp;nbsp;aks&amp;nbsp;command&amp;nbsp;invoke&amp;nbsp;runs&amp;nbsp;kubectl&amp;nbsp;inside&amp;nbsp;the&amp;nbsp;cluster" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#B6C2CE;rounded=1;arcSize=4;fontSize=11;fontStyle=0;fontColor=#3E4C59;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="2210" width="2100" height="390" as="geometry"/></mxCell><mxCell id="prod-panel" value="What this draft settles&lt;br&gt;&lt;br&gt;quota,&amp;nbsp;Israel&amp;nbsp;Central&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;used&amp;nbsp;&amp;nbsp;limit&amp;nbsp;&amp;nbsp;ask&lt;br&gt;Total&amp;nbsp;Regional&amp;nbsp;vCPUs&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;10&amp;nbsp;&amp;nbsp;&amp;nbsp;64&lt;br&gt;Standard&amp;nbsp;DASv5&amp;nbsp;Family&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0&amp;nbsp;&amp;nbsp;&amp;nbsp;64&lt;br&gt;Total&amp;nbsp;Regional&amp;nbsp;Spot&amp;nbsp;vCPUs&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;?&amp;nbsp;&amp;nbsp;&amp;nbsp;32&lt;br&gt;Public&amp;nbsp;IP&amp;nbsp;addresses&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;20&amp;nbsp;&amp;nbsp;&amp;nbsp;ok&lt;br&gt;&lt;br&gt;&lt;b&gt;Right-sized, not stripped.&lt;/b&gt; Against the hub-and-spoke draft this removes about $1,600 a month (firewall, gateway, Service Bus Premium, registry Premium, runners, Bastion) and two subnets’ worth of operations, while keeping every control that a 60,000-learner product handling minors’ data actually needs: WAF at the edge, one locked ingress address, private endpoints on every store, identity everywhere, a private API server.&lt;br&gt;&lt;br&gt;&lt;b&gt;What Static Web Apps change:&lt;/b&gt; four containers become API-only; SPA routing, previews per pull request, TLS and global delivery move to the platform; the storage $web trick is gone.&lt;br&gt;&lt;br&gt;&lt;b&gt;Still open:&lt;/b&gt; Mongo HA on from day one (+$514) or from 30k; no TURN server for support screen-share (ACS can provide one); gpt-4.1 literals in code are deployed on none of the five APIM backends." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFF6EC;strokeColor=#D0762F;rounded=1;arcSize=4;fontSize=12;fontStyle=0;fontColor=#7A3E10;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="2180" y="2210" width="1080" height="390" as="geometry"/></mxCell><mxCell id="prod-28" value="① browser, and Kata relaying xAPI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-clients" target="prod-edge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-29" value="③ /api/* and the staff APIs — HTTPS to the origin name, only from this profile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-edge" target="prod-ingpip"><mxGeometry relative="1" as="geometry" x="-0.454"><Array as="points"><mxPoint x="1928" y="397"/><mxPoint x="2190" y="397"/><mxPoint x="2190" y="573"/></Array><mxPoint as="offset" x="0" y="-9"/></mxGeometry></mxCell><mxCell id="prod-30" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-ingpip" target="prod-ilb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-31" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-ilb" target="prod-ingress"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-32" value="⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-ingress" target="prod-auth"><mxGeometry relative="1" as="geometry" x="0.91"><Array as="points"><mxPoint x="1761" y="644"/><mxPoint x="78" y="644"/><mxPoint x="78" y="1126"/></Array><mxPoint as="offset" x="-14" y="0"/></mxGeometry></mxCell><mxCell id="prod-33" value="⑦ the ES256 public key over JWKS — fetched once, cached, verified in-process; no call to auth per request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=2.4;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#8A5A0B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-authtier" target="prod-lanetier"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-34" value="⑧" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-ingress" target="prod-lanetier"><mxGeometry relative="1" as="geometry" x="0.938"><Array as="points"><mxPoint x="1755" y="639"/><mxPoint x="86" y="639"/><mxPoint x="86" y="1282"/></Array><mxPoint as="offset" x="-22" y="0"/></mxGeometry></mxCell><mxCell id="prod-35" value="⑨" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-ingress" target="prod-stafftier"><mxGeometry relative="1" as="geometry" x="0.948"><Array as="points"><mxPoint x="1767" y="634"/><mxPoint x="94" y="634"/><mxPoint x="94" y="1460"/></Array><mxPoint as="offset" x="-30" y="0"/></mxGeometry></mxCell><mxCell id="prod-36" value="⑩ publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D0762F;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#8A4416;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-lanetier" target="prod-sb"><mxGeometry relative="1" as="geometry" x="-0.66"><Array as="points"><mxPoint x="2190" y="1282"/><mxPoint x="2190" y="1358"/></Array><mxPoint as="offset" x="0" y="-9"/></mxGeometry></mxCell><mxCell id="prod-37" value="⑪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D0762F;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#8A4416;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-sb" target="prod-worktier"><mxGeometry relative="1" as="geometry" x="0.441"><Array as="points"><mxPoint x="2273" y="1400"/><mxPoint x="2198" y="1400"/><mxPoint x="2198" y="1722"/></Array><mxPoint as="offset" x="14" y="0"/></mxGeometry></mxCell><mxCell id="prod-38" value="⑫ data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#93A0AD;strokeWidth=1.4;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#67737F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-lanetier" target="prod-snpe"><mxGeometry relative="1" as="geometry" x="-0.817"><Array as="points"><mxPoint x="2182" y="1323"/><mxPoint x="2182" y="1105"/></Array><mxPoint as="offset" x="0" y="-9"/></mxGeometry></mxCell><mxCell id="prod-39" value="⑬ egress from one fixed address: every model call via APIM, Speech, Content Safety" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A4FCB;strokeWidth=2.2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#5B32A8;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.45;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-nat" target="prod-we"><mxGeometry relative="1" as="geometry" x="0.15"><Array as="points"><mxPoint x="133" y="378"/><mxPoint x="2589" y="378"/></Array><mxPoint as="offset" x="0" y="-8"/></mxGeometry></mxCell><mxCell id="prod-40" value="⑭ ministry LRS · Kata · ADO · Google" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A4FCB;strokeWidth=2.2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#5B32A8;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.12;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-nat" target="prod-clients"><mxGeometry relative="1" as="geometry" x="0.682"><Array as="points"><mxPoint x="124" y="392"/><mxPoint x="98" y="392"/></Array><mxPoint as="offset" x="120" y="12"/></mxGeometry></mxCell><mxCell id="prod-41" value="⑮ operators: VPN in West Europe, global peering, private API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1A9E63;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#0B6B3F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-vpn" target="prod-snapi"><mxGeometry relative="1" as="geometry" x="-0.146"><Array as="points"><mxPoint x="3013" y="408"/><mxPoint x="2198" y="408"/><mxPoint x="2198" y="722"/></Array><mxPoint as="offset" x="0" y="-9"/></mxGeometry></mxCell><mxCell id="prod-42" value="peering · direct" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6E57B8;strokeWidth=5;dashed=1;dashPattern=1 3;endArrow=none;startArrow=none;fontSize=11;fontStyle=1;fontColor=#4B3A8E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2515;exitDx=0;exitDy=0;entryX=0;entryY=0.597;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod-vnetapp" target="prod-vnetdata"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-12"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="3 · Development · same shape, smaller" id="dev"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dev-10" value="Development · rg-spark-dev · Israel Central" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#17212B" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="44" as="geometry"/></mxCell><mxCell id="dev-11" value="The same two-network shape and the same numbered path at a smaller size: one system node, one user pool, Spot from zero, Free Static Web Apps, the smallest database and cache — and nothing of production reachable from here." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#67737F" vertex="1" parent="1"><mxGeometry x="40" y="74" width="2600" height="40" as="geometry"/></mxCell><mxCell id="dev-clients" value="Who connects" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FBFBFC;strokeColor=#98A2AE;dashed=1;fontColor=#5C6875;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="480" height="240" as="geometry"/></mxCell><mxCell id="dev-users" value="Learners&lt;br&gt;teachers" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="70" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-staff" value="Yuvilab&lt;br&gt;staff" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="175" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-kata" value="Kata / CET&lt;br&gt;content + xAPI" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Globe.svg;" vertex="1" parent="1"><mxGeometry x="280" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-moe" value="MoE OIDC" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="385" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-moelrs" value="MoE LRS" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Globe.svg;" vertex="1" parent="1"><mxGeometry x="70" y="275" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-google" value="Google&lt;br&gt;staff sign-in" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="175" y="275" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-gha" value="GitHub Actions&lt;br&gt;OIDC, no secrets" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Builds.svg;" vertex="1" parent="1"><mxGeometry x="280" y="275" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-12" value="Kata relays xAPI; GitHub pushes images and runs deploys." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="385" y="282" width="125" height="80" as="geometry"/></mxCell><mxCell id="dev-edge" value="Global edge · afd-spark · Front Door Premium · the only WAF, closest to the client · four Static Web Apps behind it" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FAF7FF;strokeColor=#8B6FD0;dashed=1;fontColor=#6237B8;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="1440" height="240" as="geometry"/></mxCell><mxCell id="dev-fd" value="Front Door&lt;br&gt;Premium" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Front_Doors.svg;" vertex="1" parent="1"><mxGeometry x="600" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-waf" value="WAF policy&lt;br&gt;OWASP + bot + rate" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Web_Application_Firewall_Policies_WAF.svg;" vertex="1" parent="1"><mxGeometry x="710" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-dns" value="DNS zone&lt;br&gt;yuvilab.ai" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="820" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-swaweb" value="swa-spark-web&lt;br&gt;Free" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/preview/Static_Apps.svg;" vertex="1" parent="1"><mxGeometry x="950" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-swaadmin" value="swa-spark-admin" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/preview/Static_Apps.svg;" vertex="1" parent="1"><mxGeometry x="1075" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-swasupport" value="swa-spark-support" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/preview/Static_Apps.svg;" vertex="1" parent="1"><mxGeometry x="1200" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-swalrs" value="swa-spark-lrs" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/preview/Static_Apps.svg;" vertex="1" parent="1"><mxGeometry x="1325" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-routes" value="dev.spark.yuvilab.ai&lt;br&gt;&amp;nbsp;&amp;nbsp;/&amp;nbsp;&amp;nbsp;/student/*&amp;nbsp;&amp;nbsp;/teacher/*&amp;nbsp;&amp;nbsp;&amp;nbsp;swa-spark-web&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;SPA&amp;nbsp;fallback&amp;nbsp;routing&amp;nbsp;is&amp;nbsp;native&lt;br&gt;&amp;nbsp;&amp;nbsp;/api/*&amp;nbsp;&amp;nbsp;/ws/*&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;origin-dev.spark&amp;nbsp;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;ingress,&amp;nbsp;over&amp;nbsp;TLS&lt;br&gt;&amp;nbsp;&amp;nbsp;admin-&amp;nbsp;/&amp;nbsp;support-&amp;nbsp;/&amp;nbsp;lrs-dev.&amp;nbsp;&amp;nbsp;&amp;nbsp;swa-spark-{admin,support,lrs}-dev;&amp;nbsp;their&amp;nbsp;/api/*&amp;nbsp;→&amp;nbsp;ingress" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#CFDAE3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontFamily=Courier New;fontColor=#243642;" vertex="1" parent="1"><mxGeometry x="1460" y="168" width="520" height="108" as="geometry"/></mxCell><mxCell id="dev-13" value="Each Static Web App accepts traffic only from this profile: allowedIpRanges = AzureFrontDoor.Backend and a required X-Azure-FDID header in staticwebapp.config.json. The containers stop serving files; /landing, /locales, /shared and the Game Lab player move into the SWA build. Unity bundles and media stay on Blob behind the same edge." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="600" y="290" width="1380" height="70" as="geometry"/></mxCell><mxCell id="dev-we" value="West Europe · the model path stays where Cognitive Services exist · plus the operators’ door" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FBFBFC;strokeColor=#98A2AE;dashed=1;fontColor=#5C6875;" vertex="1" parent="1"><mxGeometry x="2040" y="130" width="1220" height="240" as="geometry"/></mxCell><mxCell id="dev-apim" value="apim-cotrade-prod&lt;br&gt;UNCHANGED" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/API_Management_Services.svg;" vertex="1" parent="1"><mxGeometry x="2080" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-aoai" value="Azure OpenAI × 5&lt;br&gt;priority failover" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="1"><mxGeometry x="2225" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-foundry" value="gpt-image&lt;br&gt;foundry-poland" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Cognitive_Services.svg;" vertex="1" parent="1"><mxGeometry x="2370" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-cs" value="Content Safety" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Content_Safety.svg;" vertex="1" parent="1"><mxGeometry x="2515" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-lang" value="Language · PII" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Language_Services.svg;" vertex="1" parent="1"><mxGeometry x="2660" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-speech" value="Speech" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Speech_Services.svg;" vertex="1" parent="1"><mxGeometry x="2805" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-vpn" value="vpng-yuvi-we&lt;br&gt;P2S · Entra · exists" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="2990" y="175" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-14" value="APIM keeps its own policy and we do not touch it. The existing point-to-site gateway earns its keep: peered globally to the spokes, it is how an operator reaches the private API server and the database endpoints — no Bastion, no jump box." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="2080" y="290" width="1160" height="70" as="geometry"/></mxCell><mxCell id="dev-rg" value="Israel Central · single zone · rg-spark-dev, plus the shared registry and DNS zones" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F4FAF7;strokeColor=#107C4B;dashed=1;dashPattern=8 4;fontSize=16;fontColor=#0B6B3F;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="3220" height="1760" as="geometry"/></mxCell><mxCell id="dev-vnetapp" value="vnet-app-dev · 10.71.0.0/16 · rg-spark-dev · Azure CNI Overlay, pods on 10.244.0.0/16 · Cilium dataplane, network policy on · no route tables: the NAT gateway is a subnet association, not a route" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#2F6FB5;strokeWidth=2.5;fontColor=#1F4F86;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="2100" height="1710" as="geometry"/></mxCell><mxCell id="dev-edgeband" value="At the edge of the network — two public addresses, neither of them reachable by a person" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F4F9FE;strokeColor=#3D8BD4;dashed=1;rounded=1;arcSize=3;fontSize=12;fontColor=#12456E;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="2040" height="130" as="geometry"/></mxCell><mxCell id="dev-nat" value="nat-spark-dev&lt;br&gt;Standard · single zone" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/NAT.svg;" vertex="1" parent="1"><mxGeometry x="110" y="550" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-natpip" value="pip-nat-dev&lt;br&gt;the fixed egress address" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Public_IP_Addresses.svg;" vertex="1" parent="1"><mxGeometry x="270" y="550" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-15" value="Same two addresses, same rules. Dev’s NAT address is a second entry on the ministry’s allowlist so the LRS integration is exercised end to end; the ingress address admits only Front Door, exactly as in production, so the FDID check and the Ingress rules are what runs every day, not a dev-only shortcut." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="430" y="545" width="1250" height="78" as="geometry"/></mxCell><mxCell id="dev-ingress" value="ingress-nginx" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;shadow=0;strokeWidth=1;fillColor=#2875E2;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=ing;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#26343F;" vertex="1" parent="1"><mxGeometry x="1740" y="552" width="42" height="42" as="geometry"/></mxCell><mxCell id="dev-ilb" value="lb-ingress&lt;br&gt;Standard LB · zone-redundant" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Load_Balancers.svg;" vertex="1" parent="1"><mxGeometry x="1900" y="550" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-ingpip" value="pip-ingress-dev&lt;br&gt;AzureFrontDoor.Backend only" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Public_IP_Addresses.svg;" vertex="1" parent="1"><mxGeometry x="2060" y="550" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-snapi" value="snet-apiserver · 10.71.2.0/28 · delegated to Microsoft.ContainerService/managedClusters" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FAFCFE;strokeColor=#A8BECE;fontSize=12;fontColor=#4D6275;" vertex="1" parent="1"><mxGeometry x="100" y="670" width="2040" height="105" as="geometry"/></mxCell><mxCell id="dev-aks" value="aks-spark-dev&lt;br&gt;Free tier · single zone" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/containers/Kubernetes_Services.svg;" vertex="1" parent="1"><mxGeometry x="140" y="695" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-16" value="API Server VNet Integration: the control plane is projected here behind an internal VIP, the public FQDN resolves to that private address, Entra RBAC with local accounts off. Reached by the nodes, by operators over the VPN peering, and by GitHub through az aks command invoke — which runs kubectl inside the cluster, so no runner ever needs a network path. Kubernetes 1.36, Azure Linux 3 nodes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="300" y="692" width="1820" height="72" as="geometry"/></mxCell><mxCell id="dev-snsys" value="snet-aks-system · 10.71.4.0/24 · nsg-aks-nodes · NAT gateway attached" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FAFCFE;strokeColor=#A8BECE;fontSize=12;fontColor=#4D6275;" vertex="1" parent="1"><mxGeometry x="100" y="795" width="2040" height="150" as="geometry"/></mxCell><mxCell id="dev-nsgnodes" value="nsg-aks-nodes&lt;br&gt;443 from AzureFrontDoor.Backend" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="1"><mxGeometry x="140" y="825" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-syspool" value="pool system&lt;br&gt;1 × D2as_v5 · single zone" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/VM_Scale_Sets.svg;" vertex="1" parent="1"><mxGeometry x="320" y="825" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-17" value="Taint CriticalAddonsOnly, so nothing of ours schedules here. It runs the platform: CoreDNS, metrics-server, KEDA, the workload-identity webhook, the Key Vault CSI driver, the ingress controller, cert-manager for the origin certificate, the Container Insights agent, the Policy sensor, Cilium. outboundType userAssignedNATGateway: every packet that leaves a node is SNATed to pip-nat, and the ministry allowlists exactly that address." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="500" y="822" width="1620" height="110" as="geometry"/></mxCell><mxCell id="dev-snusr" value="snet-aks-user · 10.71.8.0/22 · nsg-aks-nodes · NAT gateway attached · two pools: one for everything that is not Spot, one Spot" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FAFCFE;strokeColor=#A8BECE;fontSize=12;fontColor=#4D6275;" vertex="1" parent="1"><mxGeometry x="100" y="965" width="2040" height="1180" as="geometry"/></mxCell><mxCell id="dev-pool-npuser" value="pool npuser · D2as_v5 · 1 → 3 · single zone · identity, product, staff and the queue workers share it — the worker taint is the one thing dev does not reproduce" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#EEF4FA;strokeColor=#5B8FC4;strokeWidth=1.5;rounded=1;arcSize=3;fontSize=12;fontColor=#1F4F86;" vertex="1" parent="1"><mxGeometry x="100" y="1005" width="2040" height="775" as="geometry"/></mxCell><mxCell id="dev-authtier" value="Identity tier — one service issues the learner and teacher session; every other service only verifies it" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFBF0;strokeColor=#B7791F;strokeWidth=2;rounded=1;arcSize=3;fontSize=12;fontColor=#8A5A0B;" vertex="1" parent="1"><mxGeometry x="120" y="1045" width="2000" height="140" as="geometry"/></mxCell><mxCell id="dev-auth" value="&lt;b&gt;auth-api&lt;/b&gt;&lt;br&gt;/api/auth/*&lt;br&gt;password sign-in (Argon2id) · MoE OIDC start and callback&lt;br&gt;issues the ES256 session · refresh · logout · role resolution&lt;br&gt;1 replica · sa-auth → id-auth-dev" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=8;fontSize=11;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="140" y="1077" width="640" height="98" as="geometry"/></mxCell><mxCell id="dev-authicon" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;shadow=0;strokeWidth=1;fillColor=#B7791F;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=deploy;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#26343F;" vertex="1" parent="1"><mxGeometry x="439" y="1085" width="40" height="40" as="geometry"/></mxCell><mxCell id="dev-authnote1" value="It issues, it does not proxy. No request passes through auth on its way somewhere else: auth mints a signed session and every other service verifies that signature inside its own process." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#B6C2CE;rounded=1;arcSize=4;fontSize=11;fontStyle=0;fontColor=#3E4C59;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="800" y="1077" width="640" height="98" as="geometry"/></mxCell><mxCell id="dev-authnote2" value="Only auth holds the private key. Everyone else fetches the public half from JWKS once and caches it. Only auth writes users, sessions and the revocation list, so a compromised lane cannot mint a session." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#B6C2CE;rounded=1;arcSize=4;fontSize=11;fontStyle=0;fontColor=#3E4C59;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1460" y="1077" width="640" height="98" as="geometry"/></mxCell><mxCell id="dev-lanetier" value="Product tier — reached by a learner or teacher browser · all three build on spark-core: the credential factory, session verification, the X-Azure-FDID check, the event publisher, the Mongo and Redis clients, telemetry and the PII scrub" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F7FAFD;strokeColor=#9FB8CE;rounded=1;arcSize=3;fontSize=12;fontColor=#3A5670;" vertex="1" parent="1"><mxGeometry x="120" y="1200" width="2000" height="165" as="geometry"/></mxCell><mxCell id="dev-student" value="&lt;b&gt;student-api&lt;/b&gt;&lt;br&gt;/api/student/* · /api/xapi/*&lt;br&gt;coach SSE · xAPI ingest from Kata · mastery fold&lt;br&gt;safety gate · games API · presence&lt;br&gt;1 replica · sa-student → id-student-dev" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FA0BE;align=center;verticalAlign=bottom;spacingBottom=8;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="140" y="1235" width="640" height="120" as="geometry"/></mxCell><mxCell id="dev-studenti" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;shadow=0;strokeWidth=1;fillColor=#2875E2;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=deploy;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#26343F;" vertex="1" parent="1"><mxGeometry x="440" y="1244" width="40" height="40" as="geometry"/></mxCell><mxCell id="dev-teacher" value="&lt;b&gt;teacher-api&lt;/b&gt;&lt;br&gt;/api/teacher/*&lt;br&gt;roster · insights · wellbeing · mentoring&lt;br&gt;assistant SSE · live strip&lt;br&gt;1 replica · sa-teacher → id-teacher-dev" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FA0BE;align=center;verticalAlign=bottom;spacingBottom=8;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="800" y="1235" width="640" height="120" as="geometry"/></mxCell><mxCell id="dev-teacheri" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;shadow=0;strokeWidth=1;fillColor=#2875E2;strokeColor=none;shape=