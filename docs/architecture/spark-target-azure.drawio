ize=10;fontColor=#1E6B4A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-pe-redis" target="dev-redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev-pe-blob" value="pe-blob&lt;br&gt;10.72.0.6" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="2265" y="784" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-st" value="stsparkdatadev&lt;br&gt;games · media · attachments · archive" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="2790" y="784" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B62;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#1E6B4A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-pe-blob" target="dev-st"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev-pe-keyvault" value="pe-keyvault&lt;br&gt;10.72.0.7" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="2265" y="896" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-kv" value="kv-spark-dev&lt;br&gt;CSI-mounted secrets" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="2790" y="896" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B62;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#1E6B4A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-pe-keyvault" target="dev-kv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev-pe-appconfig" value="pe-appconfig&lt;br&gt;10.72.0.8" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="2265" y="1008" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-appcfg" value="appcs-spark-dev&lt;br&gt;App Configuration Developer" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/App_Configuration.svg;" vertex="1" parent="1"><mxGeometry x="2790" y="1008" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E8B62;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontColor=#1E6B4A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-pe-appconfig" target="dev-appcfg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev-24" value="One NIC each, static addresses; network policies stay on so nsg-pe applies to endpoint traffic." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="2250" y="1088" width="410" height="44" as="geometry"/></mxCell><mxCell id="dev-25" value="Same five endpoints as production, same private DNS zones (one set, linked to all four vnets), same NSG. The dev database is M10 burstable and the cache is Basic C0; both still sit behind endpoints with public access off, because the habit matters more than the data." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="2225" y="1200" width="1035" height="66" as="geometry"/></mxCell><mxCell id="dev-msgband" value="Messaging · sb-spark-dev · Service Bus Standard · public name, Entra only" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFAF4;strokeColor=#D0762F;rounded=1;arcSize=4;fontSize=12;fontColor=#8A4416;" vertex="1" parent="1"><mxGeometry x="2210" y="1285" width="1050" height="335" as="geometry"/></mxCell><mxCell id="dev-sb" value="sb-spark-dev" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Service_Bus.svg;" vertex="1" parent="1"><mxGeometry x="2250" y="1335" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-queues" value="topic&amp;nbsp;spark-events&lt;br&gt;&amp;nbsp;&amp;nbsp;sub-notify&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;notify.*&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;notify&lt;br&gt;&amp;nbsp;&amp;nbsp;sub-summaries&amp;nbsp;&amp;nbsp;&amp;nbsp;summaries.*&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;summaries&lt;br&gt;&amp;nbsp;&amp;nbsp;sub-lrs&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;xapi.*&amp;nbsp;mastery.*&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;lrs&lt;br&gt;queues&lt;br&gt;&amp;nbsp;&amp;nbsp;q-notify&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;fan-in&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;notify&lt;br&gt;&amp;nbsp;&amp;nbsp;q-task-generate&amp;nbsp;&amp;nbsp;&amp;nbsp;teacher&amp;nbsp;tasks&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tasks&lt;br&gt;&amp;nbsp;&amp;nbsp;q-manim-render&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;scenes&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;manim&lt;br&gt;&amp;nbsp;&amp;nbsp;q-summaries&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;on&amp;nbsp;demand&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;summaries&lt;br&gt;&amp;nbsp;&amp;nbsp;q-lrs-send&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;outbox&amp;nbsp;retries&amp;nbsp;&amp;nbsp;&amp;nbsp;lrs&lt;br&gt;&amp;nbsp;&amp;nbsp;q-game-jobs&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sessions&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;games" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#CFDAE3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontFamily=Courier New;fontColor=#243642;" vertex="1" parent="1"><mxGeometry x="2360" y="1325" width="500" height="215" as="geometry"/></mxCell><mxCell id="dev-26" value="&lt;b&gt;Standard here too&lt;/b&gt; — about $10 a month. The queue and topic names, the subscription filters and the identity roles are identical to production; the only per-environment value is the NAT address in the namespace’s IP rule." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="2880" y="1325" width="360" height="280" as="geometry"/></mxCell><mxCell id="dev-opsband" value="Shared · identity · operations" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F1F9F5;strokeColor=#3D9E73;rounded=1;arcSize=4;fontSize=12;fontColor=#0B6B3F;" vertex="1" parent="1"><mxGeometry x="2210" y="1640" width="1050" height="540" as="geometry"/></mxCell><mxCell id="dev-acr" value="yuvi720acr · Standard&lt;br&gt;Entra pull and push, admin user off" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/containers/Container_Registries.svg;" vertex="1" parent="1"><mxGeometry x="2250" y="1690" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-pdns" value="5 private DNS zones&lt;br&gt;linked to every vnet" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="2500" y="1690" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-mi" value="13 user-assigned&lt;br&gt;identities" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="2750" y="1690" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-entra" value="Entra workload&lt;br&gt;identity federation" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="3000" y="1690" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-law" value="log-spark-dev + appi&lt;br&gt;Basic Logs, sampled" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="2250" y="1820" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-alerts" value="alert rules&lt;br&gt;+ TLS web tests" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Alerts.svg;" vertex="1" parent="1"><mxGeometry x="2500" y="1820" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-policy" value="Azure Policy&lt;br&gt;for AKS · free" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="1"><mxGeometry x="2750" y="1820" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-defender" value="Defender for&lt;br&gt;Containers · from 30k" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Security_Center.svg;" vertex="1" parent="1"><mxGeometry x="3000" y="1820" width="46" height="46" as="geometry"/></mxCell><mxCell id="dev-27" value="&lt;b&gt;Shared with production:&lt;/b&gt; the registry (one image, promoted by tag), the five private DNS zones, the Front Door profile (separate endpoints and routes), the P2S gateway. &lt;b&gt;Dev’s own:&lt;/b&gt; its two vnets, the cluster, the identities (same names, different objects), the workspace, the vault, the configuration store. Nothing is peered to production and no identity holds a role on a production resource, so a mistake here cannot reach a learner’s data." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="2240" y="1950" width="990" height="220" as="geometry"/></mxCell><mxCell id="dev-legend" value="One request, end to end&lt;br&gt;&lt;br&gt;①&amp;nbsp;browser&amp;nbsp;to&amp;nbsp;Front&amp;nbsp;Door&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;TLS,&amp;nbsp;the&amp;nbsp;OWASP&amp;nbsp;set,&amp;nbsp;bot&amp;nbsp;and&amp;nbsp;rate&amp;nbsp;rules&amp;nbsp;at&amp;nbsp;the&amp;nbsp;edge.&amp;nbsp;Kata&amp;nbsp;posts&amp;nbsp;xAPI&amp;nbsp;to&amp;nbsp;the&amp;nbsp;same&amp;nbsp;profile&lt;br&gt;②&amp;nbsp;the&amp;nbsp;SPA&amp;nbsp;from&amp;nbsp;Static&amp;nbsp;Web&amp;nbsp;Apps&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;four&amp;nbsp;apps,&amp;nbsp;one&amp;nbsp;per&amp;nbsp;host;&amp;nbsp;SPA&amp;nbsp;fallback&amp;nbsp;routing&amp;nbsp;is&amp;nbsp;theirs,&amp;nbsp;not&amp;nbsp;ours;&amp;nbsp;none&amp;nbsp;answers&amp;nbsp;without&amp;nbsp;our&amp;nbsp;X-Azure-FDID&lt;br&gt;③&amp;nbsp;/api/*&amp;nbsp;to&amp;nbsp;the&amp;nbsp;ingress&amp;nbsp;address&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;one&amp;nbsp;public&amp;nbsp;IP&amp;nbsp;on&amp;nbsp;the&amp;nbsp;cluster;&amp;nbsp;its&amp;nbsp;NSG&amp;nbsp;admits&amp;nbsp;only&amp;nbsp;the&amp;nbsp;AzureFrontDoor.Backend&amp;nbsp;tag,&amp;nbsp;spark-core&amp;nbsp;rejects&amp;nbsp;a&amp;nbsp;wrong&amp;nbsp;FDID&lt;br&gt;④&amp;nbsp;the&amp;nbsp;load&amp;nbsp;balancer&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Standard,&amp;nbsp;zone-redundant,&amp;nbsp;managed&amp;nbsp;by&amp;nbsp;AKS&amp;nbsp;—&amp;nbsp;an&amp;nbsp;inbound&amp;nbsp;flow&amp;nbsp;returns&amp;nbsp;the&amp;nbsp;way&amp;nbsp;it&amp;nbsp;came,&amp;nbsp;so&amp;nbsp;no&amp;nbsp;route&amp;nbsp;table&amp;nbsp;is&amp;nbsp;needed&lt;br&gt;⑤&amp;nbsp;ingress-nginx&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the&amp;nbsp;app&amp;nbsp;routing&amp;nbsp;add-on;&amp;nbsp;host&amp;nbsp;and&amp;nbsp;path&amp;nbsp;map&amp;nbsp;held&amp;nbsp;as&amp;nbsp;Ingress&amp;nbsp;resources&amp;nbsp;in&amp;nbsp;yuvi-core;&amp;nbsp;TLS&amp;nbsp;from&amp;nbsp;cert-manager&lt;br&gt;⑥&amp;nbsp;ingress&amp;nbsp;to&amp;nbsp;auth-api&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;a&amp;nbsp;password&amp;nbsp;sign-in,&amp;nbsp;or&amp;nbsp;the&amp;nbsp;MoE&amp;nbsp;OIDC&amp;nbsp;round&amp;nbsp;trip&lt;br&gt;⑦&amp;nbsp;auth&amp;nbsp;issues&amp;nbsp;an&amp;nbsp;ES256&amp;nbsp;session&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the&amp;nbsp;lanes&amp;nbsp;cache&amp;nbsp;the&amp;nbsp;JWKS&amp;nbsp;key&amp;nbsp;and&amp;nbsp;verify&amp;nbsp;in-process;&amp;nbsp;no&amp;nbsp;call&amp;nbsp;to&amp;nbsp;auth&amp;nbsp;per&amp;nbsp;request&lt;br&gt;⑧&amp;nbsp;ingress&amp;nbsp;to&amp;nbsp;a&amp;nbsp;product&amp;nbsp;lane&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;student,&amp;nbsp;teacher,&amp;nbsp;or&amp;nbsp;the&amp;nbsp;Kata&amp;nbsp;xAPI&amp;nbsp;relay&amp;nbsp;on&amp;nbsp;a&amp;nbsp;launch&amp;nbsp;token&amp;nbsp;—&amp;nbsp;pool&amp;nbsp;npapp&lt;br&gt;⑨&amp;nbsp;ingress&amp;nbsp;to&amp;nbsp;a&amp;nbsp;staff&amp;nbsp;API&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;admin,&amp;nbsp;support,&amp;nbsp;LRS&amp;nbsp;portal&amp;nbsp;—&amp;nbsp;their&amp;nbsp;SPAs&amp;nbsp;come&amp;nbsp;from&amp;nbsp;Static&amp;nbsp;Web&amp;nbsp;Apps,&amp;nbsp;only&amp;nbsp;/api/*&amp;nbsp;reaches&amp;nbsp;here&lt;br&gt;⑩&amp;nbsp;the&amp;nbsp;lane&amp;nbsp;publishes&amp;nbsp;an&amp;nbsp;event&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Service&amp;nbsp;Bus&amp;nbsp;Standard&amp;nbsp;on&amp;nbsp;its&amp;nbsp;public&amp;nbsp;name:&amp;nbsp;SAS&amp;nbsp;off,&amp;nbsp;Entra&amp;nbsp;only,&amp;nbsp;IP&amp;nbsp;rule&amp;nbsp;=&amp;nbsp;the&amp;nbsp;NAT&amp;nbsp;address&lt;br&gt;⑪&amp;nbsp;KEDA&amp;nbsp;wakes&amp;nbsp;exactly&amp;nbsp;one&amp;nbsp;worker&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;pool&amp;nbsp;npworkers&amp;nbsp;scales&amp;nbsp;on&amp;nbsp;the&amp;nbsp;queue&amp;nbsp;that&amp;nbsp;actually&amp;nbsp;moved&lt;br&gt;⑫&amp;nbsp;lanes&amp;nbsp;and&amp;nbsp;workers&amp;nbsp;hit&amp;nbsp;the&amp;nbsp;data&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Mongo,&amp;nbsp;Redis,&amp;nbsp;Blob,&amp;nbsp;Key&amp;nbsp;Vault,&amp;nbsp;App&amp;nbsp;Configuration&amp;nbsp;—&amp;nbsp;over&amp;nbsp;the&amp;nbsp;endpoints,&amp;nbsp;across&amp;nbsp;the&amp;nbsp;direct&amp;nbsp;peering&lt;br&gt;⑬&amp;nbsp;anything&amp;nbsp;else&amp;nbsp;leaves&amp;nbsp;via&amp;nbsp;NAT&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;one&amp;nbsp;fixed&amp;nbsp;address&amp;nbsp;for&amp;nbsp;APIM&amp;nbsp;in&amp;nbsp;West&amp;nbsp;Europe&amp;nbsp;and&amp;nbsp;the&amp;nbsp;Cognitive&amp;nbsp;endpoints;&amp;nbsp;no&amp;nbsp;route&amp;nbsp;table,&amp;nbsp;no&amp;nbsp;firewall&amp;nbsp;in&amp;nbsp;the&amp;nbsp;path&lt;br&gt;⑭&amp;nbsp;and&amp;nbsp;the&amp;nbsp;four&amp;nbsp;partners&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the&amp;nbsp;ministry&amp;nbsp;LRS&amp;nbsp;(which&amp;nbsp;allowlists&amp;nbsp;that&amp;nbsp;address),&amp;nbsp;the&amp;nbsp;Kata&amp;nbsp;catalog,&amp;nbsp;ADO,&amp;nbsp;Google&lt;br&gt;⑮&amp;nbsp;an&amp;nbsp;operator&amp;nbsp;comes&amp;nbsp;over&amp;nbsp;the&amp;nbsp;VPN&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the&amp;nbsp;existing&amp;nbsp;P2S&amp;nbsp;gateway&amp;nbsp;in&amp;nbsp;West&amp;nbsp;Europe,&amp;nbsp;peered&amp;nbsp;globally&amp;nbsp;to&amp;nbsp;the&amp;nbsp;spokes,&amp;nbsp;reaches&amp;nbsp;the&amp;nbsp;private&amp;nbsp;API&amp;nbsp;server&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;a&amp;nbsp;deploy&amp;nbsp;comes&amp;nbsp;from&amp;nbsp;GitHub&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;an&amp;nbsp;OIDC&amp;nbsp;token&amp;nbsp;pushes&amp;nbsp;the&amp;nbsp;image&amp;nbsp;to&amp;nbsp;the&amp;nbsp;registry;&amp;nbsp;az&amp;nbsp;aks&amp;nbsp;command&amp;nbsp;invoke&amp;nbsp;runs&amp;nbsp;kubectl&amp;nbsp;inside&amp;nbsp;the&amp;nbsp;cluster" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#B6C2CE;rounded=1;arcSize=4;fontSize=11;fontStyle=0;fontColor=#3E4C59;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="2210" width="2100" height="390" as="geometry"/></mxCell><mxCell id="dev-panel" value="How dev differs&lt;br&gt;&lt;br&gt;Smaller everything: a Free control plane, one system node and one user node in a single zone, M10 without high availability, one replica per service, every worker scaling from zero, Free Static Web Apps, a single-zone NAT gateway. An idle day costs almost nothing.&lt;br&gt;&lt;br&gt;Identical everywhere it matters: the same two-network shape, the same subnets, the same two public addresses with the same rules, the same queue and topic names, the same identity names, the same Ingress rules, the same taints and tolerations, and the same numbered path above. A change that works here works in production without an edit.&lt;br&gt;&lt;br&gt;About 6 vCPU at rest, inside the same quota request." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFF6EC;strokeColor=#D0762F;rounded=1;arcSize=4;fontSize=12;fontStyle=0;fontColor=#7A3E10;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="2180" y="2210" width="1080" height="390" as="geometry"/></mxCell><mxCell id="dev-28" value="① browser, and Kata relaying xAPI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-clients" target="dev-edge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev-29" value="③ /api/* and the staff APIs — HTTPS to the origin name, only from this profile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-edge" target="dev-ingpip"><mxGeometry relative="1" as="geometry" x="-0.454"><Array as="points"><mxPoint x="1928" y="397"/><mxPoint x="2190" y="397"/><mxPoint x="2190" y="573"/></Array><mxPoint as="offset" x="0" y="-9"/></mxGeometry></mxCell><mxCell id="dev-30" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-ingpip" target="dev-ilb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev-31" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-ilb" target="dev-ingress"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev-32" value="⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-ingress" target="dev-auth"><mxGeometry relative="1" as="geometry" x="0.91"><Array as="points"><mxPoint x="1761" y="644"/><mxPoint x="78" y="644"/><mxPoint x="78" y="1126"/></Array><mxPoint as="offset" x="-14" y="0"/></mxGeometry></mxCell><mxCell id="dev-33" value="⑦ the ES256 public key over JWKS — fetched once, cached, verified in-process; no call to auth per request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=2.4;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#8A5A0B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-authtier" target="dev-lanetier"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev-34" value="⑧" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-ingress" target="dev-lanetier"><mxGeometry relative="1" as="geometry" x="0.938"><Array as="points"><mxPoint x="1755" y="639"/><mxPoint x="86" y="639"/><mxPoint x="86" y="1282"/></Array><mxPoint as="offset" x="-22" y="0"/></mxGeometry></mxCell><mxCell id="dev-35" value="⑨" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-ingress" target="dev-stafftier"><mxGeometry relative="1" as="geometry" x="0.948"><Array as="points"><mxPoint x="1767" y="634"/><mxPoint x="94" y="634"/><mxPoint x="94" y="1460"/></Array><mxPoint as="offset" x="-30" y="0"/></mxGeometry></mxCell><mxCell id="dev-36" value="⑩ publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D0762F;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#8A4416;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-lanetier" target="dev-sb"><mxGeometry relative="1" as="geometry" x="-0.66"><Array as="points"><mxPoint x="2190" y="1282"/><mxPoint x="2190" y="1358"/></Array><mxPoint as="offset" x="0" y="-9"/></mxGeometry></mxCell><mxCell id="dev-37" value="⑪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D0762F;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#8A4416;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-sb" target="dev-worktier"><mxGeometry relative="1" as="geometry" x="0.357"><Array as="points"><mxPoint x="2273" y="1400"/><mxPoint x="2198" y="1400"/><mxPoint x="2198" y="1657"/></Array><mxPoint as="offset" x="14" y="0"/></mxGeometry></mxCell><mxCell id="dev-38" value="⑫ data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#93A0AD;strokeWidth=1.4;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#67737F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-lanetier" target="dev-snpe"><mxGeometry relative="1" as="geometry" x="-0.817"><Array as="points"><mxPoint x="2182" y="1323"/><mxPoint x="2182" y="1105"/></Array><mxPoint as="offset" x="0" y="-9"/></mxGeometry></mxCell><mxCell id="dev-39" value="⑬ egress from one fixed address: every model call via APIM, Speech, Content Safety" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A4FCB;strokeWidth=2.2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#5B32A8;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.45;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-nat" target="dev-we"><mxGeometry relative="1" as="geometry" x="0.15"><Array as="points"><mxPoint x="133" y="378"/><mxPoint x="2589" y="378"/></Array><mxPoint as="offset" x="0" y="-8"/></mxGeometry></mxCell><mxCell id="dev-40" value="⑭ ministry LRS · Kata · ADO · Google" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A4FCB;strokeWidth=2.2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#5B32A8;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.12;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-nat" target="dev-clients"><mxGeometry relative="1" as="geometry" x="0.682"><Array as="points"><mxPoint x="124" y="392"/><mxPoint x="98" y="392"/></Array><mxPoint as="offset" x="120" y="12"/></mxGeometry></mxCell><mxCell id="dev-41" value="⑮ operators: VPN in West Europe, global peering, private API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1A9E63;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#0B6B3F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-vpn" target="dev-snapi"><mxGeometry relative="1" as="geometry" x="-0.146"><Array as="points"><mxPoint x="3013" y="408"/><mxPoint x="2198" y="408"/><mxPoint x="2198" y="722"/></Array><mxPoint as="offset" x="0" y="-9"/></mxGeometry></mxCell><mxCell id="dev-42" value="peering · direct" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6E57B8;strokeWidth=5;dashed=1;dashPattern=1 3;endArrow=none;startArrow=none;fontSize=11;fontStyle=1;fontColor=#4B3A8E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2515;exitDx=0;exitDy=0;entryX=0;entryY=0.597;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev-vnetapp" target="dev-vnetdata"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-12"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>