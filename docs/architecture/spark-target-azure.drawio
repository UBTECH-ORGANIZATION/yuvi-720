l><mxCell id="cur-18" value="The whole web app is vnet-integrated with route-all so one destination gets a fixed source address. About 300 a month of firewall for a single /32. Two public addresses and a route table sit orphaned." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="70" y="1392" width="1660" height="60" as="geometry"/></mxCell><mxCell id="cur-we" value="rg-yuvi-720 · West Europe" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F5F9FD;strokeColor=#0078D4;dashed=1;dashPattern=8 4;fontSize=16;fontColor=#0F6CBD;" vertex="1" parent="1"><mxGeometry x="1820" y="480" width="700" height="300" as="geometry"/></mxCell><mxCell id="cur-blob" value="yuvi720blobstorage&lt;br&gt;RA-GRS" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1860" y="535" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-appi" value="appi-yuvi-720&lt;br&gt;both slots" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Application_Insights.svg;" vertex="1" parent="1"><mxGeometry x="2010" y="535" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-lawwe" value="law-yuvi-720" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="2160" y="535" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-vpn2" value="vpng P2S&lt;br&gt;Entra" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="2310" y="535" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-19" value="Games, support files and the static website live here while the compute is in North Europe." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="1855" y="650" width="630" height="60" as="geometry"/></mxCell><mxCell id="cur-se" value="rg-yuvi-720 · Sweden Central — a third region carrying a second application stack" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#F5F9FD;strokeColor=#0078D4;dashed=1;dashPattern=8 4;fontSize=16;fontColor=#0F6CBD;" vertex="1" parent="1"><mxGeometry x="1820" y="810" width="700" height="390" as="geometry"/></mxCell><mxCell id="cur-cp" value="yuvi720-content-provider&lt;br&gt;B1 · the Kata stand-in" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="1855" y="865" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-support" value="spark-support-app&lt;br&gt;B1 · own plan" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="2020" y="865" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-acrlrs" value="acryuvi720lrs&lt;br&gt;LRS portal image" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/containers/Container_Registries.svg;" vertex="1" parent="1"><mxGeometry x="2185" y="865" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-alerts" value="3 alert rules&lt;br&gt;8 TLS web tests" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Alerts.svg;" vertex="1" parent="1"><mxGeometry x="2350" y="865" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-supmongo" value="spark-support-mongo&lt;br&gt;Cosmos RU MongoDB" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_DocumentDB.svg;" vertex="1" parent="1"><mxGeometry x="1855" y="990" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-supkv" value="spark-support-kv" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="2020" y="990" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-supsa" value="sparksupportsa" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="2185" y="990" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-suplaw" value="spark-support-logs&lt;br&gt;+ -insights" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="2350" y="990" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-20" value="The support app is not one resource, it is a parallel estate: its own B1 plan, its own Cosmos on the RU MongoDB API rather than the vCore clusters the product uses, and its own vault, storage, workspace and App Insights. The content provider is a Kata stand-in on a second B1 plan. Neither has a custom domain; both answer on bare azurewebsites.net with no Front Door and no WAF in front of them." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="1855" y="1105" width="630" height="85" as="geometry"/></mxCell><mxCell id="cur-pins" value="What pins the monolith&lt;br&gt;&lt;br&gt;· fire-and-forget tasks die on every deploy&lt;br&gt;· Manim renders inside the web process&lt;br&gt;· the LRS sweeper is a uvicorn lifespan task&lt;br&gt;· the event bus and presence live in process memory&lt;br&gt;· a JSON fallback writes learner data to container disk&lt;br&gt;· secrets are app settings, no WAF, httpsOnly off&lt;br&gt;· one App Insights for two slots, three regions for one product" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FFF6EC;strokeColor=#D0762F;rounded=1;arcSize=4;fontSize=12;fontStyle=0;fontColor=#7A3E10;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1820" y="1230" width="700" height="250" as="geometry"/></mxCell><mxCell id="cur-21" value="HTTPS · SSE · xAPI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="cur-people" target="cur-rgvibe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cur-22" value="X-Azure-FDID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6CBD;strokeWidth=2.6;endArrow=block;endFill=1;fontSize=11;fontColor=#0F6CBD;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entr