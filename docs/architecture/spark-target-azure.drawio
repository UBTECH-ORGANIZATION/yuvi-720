="52" as="geometry"/></mxCell><mxCell id="cur-kata" value="Kata / CET" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Globe.svg;" vertex="1" parent="1"><mxGeometry x="68" y="278" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-moe" value="MoE OIDC" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="170" y="278" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-12" value="Browsers over HTTPS with long-lived streams. Kata relays xAPI in." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="60" y="378" width="210" height="70" as="geometry"/></mxCell><mxCell id="cur-rgvibe" value="rg-vibe-coding-kids · edge shared with another product" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FAF7FF;strokeColor=#8B6FD0;dashed=1;fontColor=#6237B8;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="560" height="340" as="geometry"/></mxCell><mxCell id="cur-fd" value="Front Door Standard&lt;br&gt;fd-vibe-coding-kids" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Front_Doors.svg;" vertex="1" parent="1"><mxGeometry x="350" y="178" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-dns" value="DNS zone&lt;br&gt;yuvilab.ai" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="520" y="178" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-13" value="One profile, two endpoints, NO WAF. CacheRules is shared with yuvilab.ai so it cannot be edited freely. Origin locked only by X-Azure-FDID. admin.spark bypasses the edge entirely." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5A6773;" vertex="1" parent="1"><mxGeometry x="345" y="290" width="510" height="150" as="geometry"/></mxCell><mxCell id="cur-ext" value="Shared and external services" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#FBFBFC;strokeColor=#98A2AE;dashed=1;fontColor=#5C6875;" vertex="1" parent="1"><mxGeometry x="920" y="120" width="1600" height="340" as="geometry"/></mxCell><mxCell id="cur-apim" value="apim-cotrade-prod&lt;br&gt;BasicV2 · West Europe" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/API_Management_Services.svg;" vertex="1" parent="1"><mxGeometry x="955" y="172" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-aoai" value="Azure OpenAI × 5&lt;br&gt;priority failover" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="1"><mxGeometry x="1145" y="172" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-foundry" value="yuvi-foundry-poland&lt;br&gt;gpt-image" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;fontColor=#26343F;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/ai_machine_learning/Cognitive_Services.svg;" vertex="1" parent="1"><mxGeometry x="1335" y="172" width="52" height="52" as="geometry"/></mxCell><mxCell id="cur-speech" value="Speech&lt;br&gt;West Europe"