        <mxCell id="p1l6" value="External / third party" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#6B7684;fontSize=10;fontColor=#333D47" vertex="1" parent="1">
          <mxGeometry x="1497" y="114" width="210" height="24" as="geometry" />
