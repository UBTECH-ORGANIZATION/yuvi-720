        <!-- title -->
        <mxCell id="p1t" value="Yuvi Spark · MoE 720 — as-built architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1A202C" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1180" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1s" value="Grades 7–9 · Hebrew / Arabic / English, RTL-first · learners are minors, so a model error is a safety event, not a UX bug · content is third-party (Kata / CET); we own routing, the learner model and the tutor." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4A5568" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1180" height="40" as="geometry" />
