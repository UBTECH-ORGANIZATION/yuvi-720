        <!-- ============ BAND 1 : CLIENTS ============ -->
        <mxCell id="p1b1" value="① CLIENTS — browser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#CBD2D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3E4C59" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1200" height="162" as="geometry" />
        </mxCell>
        <mxCell id="p1c1" value="&lt;b&gt;Learner SPA&lt;/b&gt;&lt;br&gt;React + TS (Vite) · hand-rolled pushState router · 11 context providers" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="58" y="148" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1c2" value="&lt;b&gt;Teacher + Admin SPA&lt;/b&gt; — same bundle, role-gated&lt;br&gt;⚠ built and tested, not merged to main → not deployed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;fontSize=10;fontColor=#7B241C;dashed=1" vertex="1" parent="1">
          <mxGeometry x="458" y="148" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1c4" value="&lt;b&gt;Kata / CET content player&lt;/b&gt; — cross-origin iframe&lt;br&gt;CET's own player cannot be framed (SameSite SSO loop) → host blocklist + own tab" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#6B7684;fontSize=10;fontColor=#333D47" vertex="1" parent="1">
          <mxGeometry x="58" y="204" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1c5" value="&lt;b&gt;SSE / EventSource (multiplexed)&lt;/b&gt;&lt;br&gt;coach nudges · teacher alerts · notifications · presence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="458" y="204" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1c6" value="&lt;b&gt;i18n he · ar · en, RTL-first&lt;/b&gt;&lt;br&gt;2,113 keys × 3 locales · no learner state in browser storage" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="858" y="204" width="364" height="48" as="geometry" />
        </mxCell>

        <!-- ============ BAND 2 : APPLICATION ============ -->
        <mxCell id="p1b2" value="② APPLICATION — Azure App Service `ubi-yuvi-720` · one container image, ONE uvicorn worker (FastAPI serves the API and the built React bundle)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#CBD2D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3E4C59" vertex="1" parent="1">
          <mxGeometry x="40" y="292" width="1200" height="670" as="geometry" />
        </mxCell>

        <!-- col A -->
        <mxCell id="p1gA" value="TRANSPORT · AUTH · INGEST" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B4BDC6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616E7C" vertex="1" parent="1">
          <mxGeometry x="58" y="330" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p1a1" value="FastAPI · 23 routers, thin handlers" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="70" y="358" width="356" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1a2" value="Identity from the session cookie only · HS256 JWT (12 h) · PBKDF2 600k" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=10;fontColor=#12403A" vertex="1" parent="1">
          <mxGeometry x="70" y="394" width="356" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1a3" value="xAPI ingest /api/xapi · per-launch token · idempotent on statement id" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="70" y="434" width="356" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1a4" value="MCP facade — read-only content-catalog tools (streamable HTTP)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="70" y="474" width="356" height="34" as="geometry" />
        </mxCell>

        <!-- col B -->
        <mxCell id="p1gB" value="ORCHESTRATION — explicit control flow, not model-decided" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B4BDC6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616E7C" vertex="1" parent="1">
          <mxGeometry x="458" y="330" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p1b_1" value="Python call graph decides the sequence — behaviour is complex but predictable" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="470" y="358" width="356" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1b_2" value="tutor_decision — fixed strategy / intention taxonomies + VanLehn hint ladder, logged per turn for teacher explainability" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="470" y="398" width="356" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p1b_3" value="Planner + learning_path — pure, deterministic, recomputed from the event log (no LLM sequences the syllabus)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="470" y="446" width="356" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1b_4" value="⚠ Trigger engine + realtime bus are IN-PROCESS → single worker only" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;fontSize=10;fontColor=#7B241C;dashed=1" vertex="1" parent="1">
          <mxGeometry x="470" y="486" width="356" height="26" as="geometry" />
        </mxCell>

        <!-- col C -->
        <mxCell id="p1gC" value="AGENTS — narrow, single-responsibility specialists" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B4BDC6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616E7C" vertex="1" parent="1">
          <mxGeometry x="858" y="330" width="364" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p1c_1" value="&lt;b&gt;Learning Coach (F3)&lt;/b&gt; — streaming companion + 12 proactive nudge types" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=10;fontColor=#1A365D" vertex="1" parent="1">
          <mxGeometry x="870" y="358" width="340" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1c_2" value="&lt;b&gt;Teacher Assistant (F6)&lt;/b&gt; — the one real tool-calling loop&lt;br&gt;bounded: 8 calls · 4 rounds · 30 s" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=10;fontColor=#1A365D" vertex="1" parent="1">
          <mxGeometry x="870" y="398" width="340" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1c_3" value="Pedagogical · Onboarding · Reflection · Insights · Competency" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=10;fontColor=#1A365D" vertex="1" parent="1">
          <mxGeometry x="870" y="442" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1c_4" value="Visual planner → Manim render in an ISOLATED worker process (validated data spec — model-authored code is never executed)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=10;fontColor=#12403A" vertex="1" parent="1">
          <mxGeometry x="870" y="478" width="340" height="34" as="geometry" />
        </mxCell>

        <!-- row 2 : model access -->
        <mxCell id="p1gD" value="MODEL ACCESS — one seam, owned by us" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B4BDC6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616E7C" vertex="1" parent="1">
          <mxGeometry x="58" y="534" width="1166" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1d1" value="&lt;b&gt;Microsoft Agent Framework&lt;/b&gt; — agent abstraction only&lt;br&gt;a thin BaseChatClient adapter, one call site, falls back to raw streaming.&lt;br&gt;Deliberately NOT given ownership of model access or telemetry." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="70" y="566" width="372" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1d2" value="&lt;b&gt;services/llm.py — the single choke point&lt;/b&gt;&lt;br&gt;call_llm / call_llm_stream · json mode · tool calling · SSE.&lt;br&gt;⚠ no retry / backoff / circuit breaker: a non-200 degrades to canned text." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=10;fontColor=#12403A" vertex="1" parent="1">
          <mxGeometry x="458" y="566" width="372" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1d3" value="&lt;b&gt;UsageContext on every single call&lt;/b&gt; → one ai_usage_events row&lt;br&gt;actor type · 720 feature · operation · session — never prompts, outputs or PII.&lt;br&gt;Tiering: &lt;b&gt;strong&lt;/b&gt; for generation, &lt;b&gt;mini&lt;/b&gt; for classification + extraction." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=10;fontColor=#1A365D" vertex="1" parent="1">
          <mxGeometry x="846" y="566" width="372" height="70" as="geometry" />
        </mxCell>

        <!-- row 3 : enforcement -->
        <mxCell id="p1gE" value="SAFETY + PRIVACY ENFORCEMENT — in code, not in prompts.  A prompt is a request; code is a promise." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#207A6B;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#207A6B" vertex="1" parent="1">
          <mxGeometry x="58" y="658" width="1166" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p1e1" value="&lt;b&gt;Tier-1 input gate&lt;/b&gt;&lt;br&gt;deterministic redaction of e-mail, national ID (Luhn-checked), phone, long digit runs, URLs — on every message, before any prompt" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=9;fontColor=#12403A" vertex="1" parent="1">
          <mxGeometry x="70" y="690" width="222" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1e2" value="&lt;b&gt;Disclosure classifier&lt;/b&gt;&lt;br&gt;none / frustration / interest / personal / distress.&lt;br&gt;&lt;b&gt;Fails closed:&lt;/b&gt; on outage → 'review', reply continues, throttled flag tells the teacher the screen was down" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=9;fontColor=#12403A" vertex="1" parent="1">
          <mxGeometry x="306" y="690" width="222" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1e3" value="&lt;b&gt;answer_guard&lt;/b&gt; — per sentence, on the way OUT.&lt;br&gt;The coach is given the correct answer so it can guide precisely, so 'do not reveal' in a prompt is not enough. A reveal drops the remainder of the reply." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=9;fontColor=#12403A" vertex="1" parent="1">
          <mxGeometry x="542" y="690" width="222" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1e4" value="&lt;b&gt;Context Engine allow-lists&lt;/b&gt;&lt;br&gt;per-agent read / write dotted paths. Coach write set is empty. The teacher AI is denied identity, raw mapping scores and the learner's private memory." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=9;fontColor=#12403A" vertex="1" parent="1">
          <mxGeometry x="778" y="690" width="222" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1e5" value="&lt;b&gt;Tool authorization&lt;/b&gt;&lt;br&gt;scope resolved server-side before the loop starts; every learner id the model supplies is a claim, re-checked live in the DB. Refusals are worded so probing leaks nothing. Audited by key, never value." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=9;fontColor=#12403A" vertex="1" parent="1">
          <mxGeometry x="1014" y="690" width="204" height="100" as="geometry" />
        </mxCell>

        <!-- row 4 : memory -->
        <mxCell id="p1gF" value="MEMORY — three layers, structured, not ad-hoc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B4BDC6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#616E7C" vertex="1" parent="1">
          <mxGeometry x="58" y="812" width="1166" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1f1" value="&lt;b&gt;1 · Working memory&lt;/b&gt;&lt;br&gt;`agent_sessions` — last 20 turns capped, last 8 enter the prompt" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF6E3;strokeColor=#B7791F;fontSize=10;fontColor=#5F370E" vertex="1" parent="1">
          <mxGeometry x="70" y="844" width="276" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p1f2" value="&lt;b&gt;2 · Full transcript&lt;/b&gt;&lt;br&gt;`agent_conversations` / `agent_messages` — cursor-paginated, activity-scoped, soft delete. Audit and context." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF6E3;strokeColor=#B7791F;fontSize=10;fontColor=#5F370E" vertex="1" parent="1">
          <mxGeometry x="366" y="844" width="276" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p1f3" value="&lt;b&gt;3 · Learner Brain (long-term)&lt;/b&gt;&lt;br&gt;one doc per pseudonymous id · typed themes: kind, confidence, status, evidence refs.&lt;br&gt;&lt;b&gt;Beliefs the model inferred from chat and the learner never confirmed decay over time.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF6E3;strokeColor=#B7791F;fontSize=10;fontColor=#5F370E" vertex="1" parent="1">
          <mxGeometry x="662" y="844" width="276" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p1f4" value="&lt;b&gt;Single-writer consolidator&lt;/b&gt;&lt;br&gt;mini-model extraction → independent content-safety screen (fail-closed) → hard-capped writable field set. Chat can never write mastery." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=10;fontColor=#12403A" vertex="1" parent="1">
          <mxGeometry x="958" y="844" width="260" height="86" as="geometry" />
        </mxCell>

        <!-- ============ BAND 3 : DATA ============ -->
        <mxCell id="p1b3" value="③ DATA — Cosmos DB (MongoDB API), document store, no ORM / no migrations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#CBD2D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3E4C59" vertex="1" parent="1">
          <mxGeometry x="40" y="982" width="1200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p1n1" value="&lt;b&gt;Cosmos DB · Mongo API&lt;/b&gt;&lt;br&gt;learners (the brain) · learning_events · agent_* · ai_usage_events · lrs_outbox · teacher_tool_calls · org · users" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#FDF6E3;strokeColor=#B7791F;fontSize=10;fontColor=#5F370E;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="58" y="1020" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1n2" value="&lt;b&gt;⚠ JSON file fallback on container disk&lt;/b&gt;&lt;br&gt;every store falls back per-call on any Mongo error. Docstrings say 'demo only' — the path is live in production: local disk, lost on restart, divergent per instance, no alert." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;fontSize=10;fontColor=#7B241C;dashed=1" vertex="1" parent="1">
          <mxGeometry x="368" y="1020" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1n3" value="&lt;b&gt;Write discipline&lt;/b&gt;&lt;br&gt;field-scoped $set + version bump, never whole-document replace, so several writers can touch one brain safely.&lt;br&gt;Indexes bootstrapped best-effort at boot, isolated per step." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="678" y="1020" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1n4" value="&lt;b&gt;Append-only, no TTL — on purpose&lt;/b&gt;&lt;br&gt;teacher_tool_calls: the record of what an AI was asked to do with minors' data.&lt;br&gt;lrs_outbox: permanent ministry audit ledger.&lt;br&gt;Retention is a policy decision, not a default." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="968" y="1020" width="254" height="110" as="geometry" />
        </mxCell>

        <!-- ============ BAND 4 : DELIVERY ============ -->
        <mxCell id="p1b4" value="④ DELIVERY + OPERATIONS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#CBD2D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3E4C59" vertex="1" parent="1">
          <mxGeometry x="40" y="1172" width="1200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1o1" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;build image → ACR `yuvi720acr` → auto-deploy to the &lt;b&gt;dev slot&lt;/b&gt;.&lt;br&gt;16 required app settings asserted before deploy. Production only via a manual slot swap." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="58" y="1210" width="280" height="98" as="geometry" />
        </mxCell>
        <mxCell id="p1o2" value="&lt;b&gt;⚠ No test gate in CI (main app)&lt;/b&gt;&lt;br&gt;1,060 backend tests exist and pass locally in 44 s. Known debt — the correct pattern (test gate + health poll after deploy) already exists in the admin service." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;fontSize=10;fontColor=#7B241C;dashed=1" vertex="1" parent="1">
          <mxGeometry x="358" y="1210" width="280" height="98" as="geometry" />
        </mxCell>
        <mxCell id="p1o3" value="&lt;b&gt;Admin service&lt;/b&gt; — separate App Service&lt;br&gt;Google OAuth + e-mail allowlist. Reads ai_usage_events read-only → cost and usage reporting. Never exposed from the learner app." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="658" y="1210" width="280" height="98" as="geometry" />
        </mxCell>
        <mxCell id="p1o4" value="&lt;b&gt;Azure Monitor + OpenTelemetry&lt;/b&gt;&lt;br&gt;FastAPI auto-instrumentation on both services." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="1">
          <mxGeometry x="958" y="1210" width="264" height="98" as="geometry" />
        </mxCell>

        <!-- ============ RIGHT COLUMN : EXTERNAL ============ -->
        <mxCell id="p1b5" value="⑤ EXTERNAL SERVICES + PLATFORM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#CBD2D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3E4C59" vertex="1" parent="1">
          <mxGeometry x="1270" y="190" width="450" height="1132" as="geometry" />
        </mxCell>

        <mxCell id="p1x1" value="&lt;b&gt;APIM — the AI Gateway&lt;/b&gt;&lt;br&gt;&lt;b&gt;The single control point.&lt;/b&gt; Quotas, metering, caching, and the ability to swap provider or region without touching application code.&lt;br&gt;No direct provider call exists anywhere in the codebase." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;strokeWidth=2.5;fontSize=10;fontColor=#1A365D" vertex="1" parent="1">
          <mxGeometry x="1288" y="228" width="414" height="98" as="geometry" />
        </mxCell>
        <mxCell id="p1x2" value="&lt;b&gt;Azure OpenAI&lt;/b&gt;&lt;br&gt;strong tier = generation · mini tier = classification and extraction.&lt;br&gt;Azure AI Foundry endpoint configured as a fallback path." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=10;fontColor=#1A365D" vertex="1" parent="1">
          <mxGeometry x="1288" y="342" width="414" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p1x3" value="&lt;b&gt;Azure AI Speech&lt;/b&gt; — companion read-aloud.&lt;br&gt;Metered in characters, its real billing unit; browser TTS as fallback." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#6B7684;fontSize=10;fontColor=#333D47" vertex="1" parent="1">
          <mxGeometry x="1288" y="446" width="414" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1x4" value="&lt;b&gt;Kata / CET content platform&lt;/b&gt;&lt;br&gt;catalog (X-API-Key) · xAPI launcher · relays every content statement back to PUBLIC_APP_URL/api/xapi.&lt;br&gt;Boot-time reachability probe: a dead relay silently drops all learning evidence." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#6B7684;fontSize=10;fontColor=#333D47" vertex="1" parent="1">
          <mxGeometry x="1288" y="532" width="414" height="98" as="geometry" />
        </mxCell>
        <mxCell id="p1x5" value="&lt;b&gt;Ministry of Education LRS&lt;/b&gt;&lt;br&gt;OAuth · outbox with retry and dedup on the same statement id · report-and-forget: reporting never blocks a learner feature.&lt;br&gt;Egress pinned to the Azure Firewall IP; developers reach it over an Entra VPN with a single /32 route." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#6B7684;fontSize=10;fontColor=#333D47" vertex="1" parent="1">
          <mxGeometry x="1288" y="646" width="414" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p1x6" value="&lt;b&gt;Azure Communication Services&lt;/b&gt; — transactional e-mail (contact form, campaign lead routing)." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#6B7684;fontSize=10;fontColor=#333D47" vertex="1" parent="1">
          <mxGeometry x="1288" y="770" width="414" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1x7" value="&lt;b&gt;Azure Container Registry&lt;/b&gt; `yuvi720acr` — both images." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#6B7684;fontSize=10;fontColor=#333D47" vertex="1" parent="1">
          <mxGeometry x="1288" y="846" width="414" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p1x8" value="&lt;b&gt;GAP #1 · Azure AI Content Safety (managed)&lt;/b&gt;&lt;br&gt;input + output filtering and jailbreak / prompt-shield protection.&lt;br&gt;What exists today is a first-party base layer: deterministic redaction, an LLM disclosure classifier and an LLM memory-content guardian. In a product whose users are children this is the first gap I would close." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=10;fontColor=#3C2A6B;dashed=1" vertex="1" parent="1">
          <mxGeometry x="1288" y="908" width="414" height="122" as="geometry" />
        </mxCell>
        <mxCell id="p1x9" value="&lt;b&gt;GAP #2 · Key Vault + managed identity + GitHub OIDC&lt;/b&gt;&lt;br&gt;today: App Service application settings, and a service-principal secret in GitHub. Target: no long-lived credential anywhere." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=10;fontColor=#3C2A6B;dashed=1" vertex="1" parent="1">
          <mxGeometry x="1288" y="1046" width="414" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p1x10" value="&lt;b&gt;GAP #3 · Redis&lt;/b&gt; — sessions, SSE fan-out, trigger cooldowns.&lt;br&gt;The one change that unlocks more than one worker. See page 4." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=10;fontColor=#3C2A6B;dashed=1" vertex="1" parent="1">
          <mxGeometry x="1288" y="1150" width="414" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1x11" value="&lt;b&gt;GAP #4 · Service Bus&lt;/b&gt; — async queues for LRS delivery, Manim renders and weekly digests, so slow work leaves the request path." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=10;fontColor=#3C2A6B;dashed=1" vertex="1" parent="1">
          <mxGeometry x="1288" y="1236" width="414" height="70" as="geometry" />
        </mxCell>

        <!-- ============ EDGES ============ -->
        <mxCell id="p1ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;fontSize=10;fontColor=#3E4C59;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="p1b1" target="p1b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1ed1l" value="HTTPS · session cookie · SSE" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#3E4C59" vertex="1" connectable="0" parent="p1ed1">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="p1ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;exitX=0.35;exitY=1;entryX=0.35;entryY=0" edge="1" parent="1" source="p1b2" target="p1b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1ed3" value="EVERY model call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2B6CB0;strokeWidth=2.5;fontSize=10;fontColor=#1A365D;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="p1d3" target="p1x1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1ed4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2B6CB0;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="p1x1" target="p1x2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1ed5" value="catalog · launcher · xAPI relay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7684;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;startArrow=block;startFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="p1a3" target="p1x4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1ed6" value="outbox · never blocks a feature" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7684;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="p1gE" target="p1x5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1ed7" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="p1o1" target="p1b2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="18" y="1259" />
              <mxPoint x="18" y="627" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="p1ed8" value="reads ai_usage_events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1" edge="1" parent="1" source="p1o3" target="p1n1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="798" y="1166" />
              <mxPoint x="203" y="1166" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================ -->
  <!-- PAGE 2 — AI REQUEST PATH                                     -->
  <!-- ============================================================ -->
  <diagram name="2 · One learner message" id="page-path">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="20" />
        <mxCell id="21" parent="20" />

        <mxCell id="p2t" value="One learner message → the model" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1A202C" vertex="1" parent="21">
          <mxGeometry x="40" y="18" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p2s" value="The sequence is an explicit Python call graph, not an emergent agent loop. Blue = a provider call. Teal = a guarantee enforced in code. White = deterministic logic." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4A5568" vertex="1" parent="21">
          <mxGeometry x="40" y="52" width="1000" height="34" as="geometry" />
        </mxCell>

        <mxCell id="p2f1" value="&lt;b&gt;1&lt;/b&gt;  POST /api/agent/coach/stream — SSE opens. The AI-use disclosure is the first event on the wire." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="110" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f2" value="&lt;b&gt;2&lt;/b&gt;  Tier-1 input gate — deterministic PII redaction before any prompt exists" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=11;fontColor=#12403A;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="184" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f3" value="&lt;b&gt;3&lt;/b&gt;  Disclosure classifier   ·   &lt;b&gt;model call 1 — mini&lt;/b&gt;&lt;br&gt;distress ⇒ fixed script + realtime alert to the teacher, and no generated reply at all" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=11;fontColor=#1A365D;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="258" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f4" value="&lt;b&gt;4&lt;/b&gt;  Build the context bundle — Context Engine projects only the coach's read slice" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=11;fontColor=#12403A;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="332" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f5" value="&lt;b&gt;5&lt;/b&gt;  tutor_decision — error type → strategy + intention from fixed taxonomies, plus the hint ladder. The triple is logged: this is the teacher-facing 'why the tutor did that'." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="406" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f6" value="&lt;b&gt;6&lt;/b&gt;  Compose messages: rules → history (8 turns) → context block → user message.&lt;br&gt;Context sits last, closest to generation, on purpose." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="480" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f7" value="&lt;b&gt;7&lt;/b&gt;  Stream the reply   ·   &lt;b&gt;model call 2 — strong or mini&lt;/b&gt;&lt;br&gt;through the MAF adapter, falling back to the raw stream on any framework error" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=11;fontColor=#1A365D;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="554" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f8" value="&lt;b&gt;8&lt;/b&gt;  answer_guard — every sentence checked BEFORE it is yielded to the client" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=11;fontColor=#12403A;align=left;spacingLeft=12;strokeWidth=2.5" vertex="1" parent="21">
          <mxGeometry x="360" y="628" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f9" value="&lt;b&gt;9&lt;/b&gt;  Conversation title   ·   &lt;b&gt;model call 3 — mini&lt;/b&gt;, once per thread" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=11;fontColor=#1A365D;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="702" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f10" value="&lt;b&gt;10&lt;/b&gt;  Persist the turn — working memory (capped) + durable transcript, tagged with the exact question the learner was on" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="776" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f11" value="&lt;b&gt;11&lt;/b&gt;  Memory consolidation   ·   &lt;b&gt;model calls 4 and 5 — mini&lt;/b&gt;&lt;br&gt;extract candidates → independent content-safety screen (fail-closed) → single-writer update" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=11;fontColor=#1A365D;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="850" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2f12" value="&lt;b&gt;12&lt;/b&gt;  Optional: visual plan   ·   &lt;b&gt;model call 6&lt;/b&gt;   → Manim renders in an isolated worker from a validated data spec" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=11;fontColor=#1A365D;align=left;spacingLeft=12" vertex="1" parent="21">
          <mxGeometry x="360" y="924" width="560" height="54" as="geometry" />
        </mxCell>

        <!-- flow arrows -->
        <mxCell id="p2a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f1" target="p2f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f2" target="p2f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f3" target="p2f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f4" target="p2f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f5" target="p2f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f6" target="p2f7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f7" target="p2f8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f8" target="p2f9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2a9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f9" target="p2f10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2a10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f10" target="p2f11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2a11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="21" source="p2f11" target="p2f12"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- callouts -->
        <mxCell id="p2n1" value="&lt;b&gt;Fails closed.&lt;/b&gt;&lt;br&gt;If the classifier is unreachable the category becomes 'review': the learner still gets an answer, and a throttled wellbeing flag tells the teacher the safety screen was down.&lt;br&gt;&lt;br&gt;An outage can never silently disable distress detection." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#207A6B;fontSize=10;fontColor=#12403A;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="21">
          <mxGeometry x="980" y="248" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2n1e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#207A6B;dashed=1;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.3" edge="1" parent="21" source="p2f3" target="p2n1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p2n2" value="&lt;b&gt;This step is the retrieval — and there is no vector store.&lt;/b&gt;&lt;br&gt;The exact current question, the provider's own teaching notes for that sub-item, the last five xAPI events, and memory themes ranked with decay — all fetched &lt;b&gt;by id&lt;/b&gt;.&lt;br&gt;&lt;br&gt;The corpus is a structured catalogue with stable identifiers, not a document blob, so id lookup beats nearest-neighbour search on both precision and cost." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#207A6B;fontSize=10;fontColor=#12403A;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="21">
          <mxGeometry x="980" y="392" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2n2e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#207A6B;dashed=1;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.2" edge="1" parent="21" source="p2f4" target="p2n2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p2n3" value="&lt;b&gt;The example I would give in the room.&lt;/b&gt;&lt;br&gt;The tutor is deliberately handed the correct answer so it can guide precisely. That makes a prompt rule saying 'do not reveal it' insufficient — asked directly, the model complies, and it did in production.&lt;br&gt;&lt;br&gt;So the check runs sentence by sentence on the way out, and a reveal drops the rest of the reply and substitutes a refusal.&lt;br&gt;&lt;br&gt;&lt;b&gt;A prompt is a request. Code is a promise.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#207A6B;strokeWidth=2.5;fontSize=10;fontColor=#12403A;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="21">
          <mxGeometry x="980" y="588" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p2n3e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#207A6B;dashed=1;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.2" edge="1" parent="21" source="p2f8" target="p2n3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p2n4" value="&lt;b&gt;What this diagram made visible&lt;/b&gt;&lt;br&gt;&lt;br&gt;One learner message is &lt;b&gt;four to seven provider calls&lt;/b&gt; — safety classification, the answer itself, memory extraction and its screening.&lt;br&gt;&lt;br&gt;I only know that because every call writes a usage event with clean, PII-free attribution, so cost questions are answered from data rather than from intuition.&lt;br&gt;&lt;br&gt;The strong / mini split is the main lever already pulled: generation on the strong model, classification and extraction on the small one.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not yet done:&lt;/b&gt; caching the classifier, a per-learner budget, and retry with backoff at the gateway." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF6E3;strokeColor=#B7791F;fontSize=10;fontColor=#5F370E;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="21">
          <mxGeometry x="980" y="800" width="330" height="270" as="geometry" />
        </mxCell>

        <mxCell id="p2n5" value="&lt;b&gt;Why the flow is written out, not delegated&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each agent owns one narrow job, and the sequence between them is explicit control flow rather than a model deciding what to call next.&lt;br&gt;&lt;br&gt;The behaviour is complex; it is also &lt;b&gt;reproducible&lt;/b&gt;. For a product used by minors, that trade is not close." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="21">
          <mxGeometry x="40" y="110" width="290" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p2n6" value="&lt;b&gt;What never enters a prompt&lt;/b&gt;&lt;br&gt;&lt;br&gt;· the learner's name (the greeting is composed in Python and streamed straight to the panel)&lt;br&gt;· any identity field&lt;br&gt;· raw questionnaire scores&lt;br&gt;· numeric mastery values&lt;br&gt;&lt;br&gt;The teacher's assistant writes a student &lt;b&gt;reference token&lt;/b&gt; and the client substitutes the real name at render: the model never sees a name, the teacher always does." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=10;fontColor=#12403A;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="21">
          <mxGeometry x="40" y="336" width="290" height="230" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================ -->
  <!-- PAGE 3 — MEMORY + ENFORCEMENT                                -->
  <!-- ============================================================ -->
  <diagram name="3 · Memory + the boundary" id="page-memory">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="40" />
        <mxCell id="41" parent="40" />

        <mxCell id="p3t" value="Memory, and the boundary that keeps it private" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1A202C" vertex="1" parent="41">
          <mxGeometry x="40" y="18" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p3s" value="Agents are stateless specialists. All durable knowledge lives in one document per learner, keyed by a pseudonymous id — and each agent is projected only the slice it needs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4A5568" vertex="1" parent="41">
          <mxGeometry x="40" y="52" width="1100" height="34" as="geometry" />
        </mxCell>

        <mxCell id="p3g1" value="THE THREE LAYERS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#CBD2D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3E4C59" vertex="1" parent="41">
          <mxGeometry x="40" y="110" width="700" height="600" as="geometry" />
        </mxCell>

        <mxCell id="p3m1" value="&lt;b&gt;1 · Short-term — the current conversation&lt;/b&gt;&lt;br&gt;`agent_sessions`. Last 20 turns retained, last 8 injected into the prompt. Bounded on purpose: the prompt window is a budget, not a scrapbook." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF6E3;strokeColor=#B7791F;fontSize=11;fontColor=#5F370E;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="41">
          <mxGeometry x="60" y="150" width="660" height="86" as="geometry" />
        </mxCell>

        <mxCell id="p3m2" value="&lt;b&gt;2 · Full transcript — audit and context&lt;/b&gt;&lt;br&gt;`agent_conversations` + `agent_messages`. Append-only, cursor-paginated so opening the panel never loads a whole history. Threads are scoped to a learning activity: opened at launch, closed by a trusted completion event. Soft delete only — a learner can hide a thread; the record survives." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF6E3;strokeColor=#B7791F;fontSize=11;fontColor=#5F370E;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="41">
          <mxGeometry x="60" y="256" width="660" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p3m3" value="&lt;b&gt;3 · Learner Brain — long-term model of the learner&lt;/b&gt;&lt;br&gt;One document, keyed by a non-identifying id. Typed themes rather than free text: &lt;b&gt;kind&lt;/b&gt; (interest · preference · challenge · strategy · self-belief · motivation pattern · goal), &lt;b&gt;confidence&lt;/b&gt;, &lt;b&gt;status&lt;/b&gt; (candidate · active · uncertain · contradicted · forgotten), &lt;b&gt;evidence references&lt;/b&gt;, and how many distinct sessions reaffirmed it.&lt;br&gt;&lt;br&gt;Forget, contradict and correct are first-class operations. 'I don't like football any more' supersedes the old belief and leaves an audit trail instead of deleting history." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF6E3;strokeColor=#B7791F;strokeWidth=2.5;fontSize=11;fontColor=#5F370E;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="41">
          <mxGeometry x="60" y="386" width="660" height="170" as="geometry" />
        </mxCell>

        <mxCell id="p3m4" value="&lt;b&gt;The interesting bit: confidence decays&lt;/b&gt;&lt;br&gt;A belief the model inferred from a single chat message, that the learner never confirmed, loses retrieval weight with age. What the model guessed once is not the same thing as what the learner told us — so the data model refuses to treat them the same." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;strokeWidth=2.5;fontSize=11;fontColor=#12403A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="41">
          <mxGeometry x="60" y="576" width="660" height="112" as="geometry" />
        </mxCell>

        <mxCell id="p3g2" value="WRITE PATH — one writer, one lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#CBD2D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3E4C59" vertex="1" parent="41">
          <mxGeometry x="40" y="730" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p3w1" value="learner turn" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=10;fontColor=#1F2933" vertex="1" parent="41">
          <mxGeometry x="60" y="790" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3w2" value="mini model extracts candidates, judged against what is already stored" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;fontSize=10;fontColor=#1A365D" vertex="1" parent="41">
          <mxGeometry x="196" y="790" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3w3" value="&lt;b&gt;independent&lt;/b&gt; safety guardian screens every value for a minor's profile — fails closed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=10;fontColor=#12403A" vertex="1" parent="41">
          <mxGeometry x="372" y="790" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3w4" value="single writer, hard-capped field set — chat can never write mastery" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;fontSize=10;fontColor=#12403A" vertex="1" parent="41">
          <mxGeometry x="558" y="790" width="162" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3w5" value="Numbers never come from a model. Mastery and progress are derived from real xAPI evidence; the model only phrases verbal, non-numeric feedback." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#4A5568" vertex="1" parent="41">
          <mxGeometry x="60" y="862" width="660" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3we1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;" edge="1" parent="41" source="p3w1" target="p3w2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3we2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;" edge="1" parent="41" source="p3w2" target="p3w3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3we3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;" edge="1" parent="41" source="p3w3" target="p3w4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p3g3" value="THE CONTEXT ENGINE — least-context, enforced in code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#207A6B;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#207A6B" vertex="1" parent="41">
          <mxGeometry x="770" y="110" width="890" height="820" as="geometry" />
        </mxCell>

        <mxCell id="p3d1" value="Every agent is handed a projection of the brain, not the brain. Read paths and write paths are declared per agent and checked before the database is touched — so a jailbroken prompt still cannot read or write outside its slice." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#4A5568" vertex="1" parent="41">
          <mxGeometry x="790" y="146" width="850" height="46" as="geometry" />
        </mxCell>

        <mxCell id="p3tbl" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;font-family:Helvetica&quot;&gt;&lt;tr style=&quot;background:#E9EDF1&quot;&gt;&lt;th style=&quot;border:1px solid #C6CED6;padding:5px;text-align:left&quot;&gt;Agent&lt;/th&gt;&lt;th style=&quot;border:1px solid #C6CED6;padding:5px;text-align:left&quot;&gt;May read&lt;/th&gt;&lt;th style=&quot;border:1px solid #C6CED6;padding:5px;text-align:left&quot;&gt;May write&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;&lt;b&gt;Learning Coach&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;locale, interests, preferences, learning style, strengths, challenges, strategies, goals, current state, teacher directives, memory, mastery, description&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;&lt;b&gt;nothing&lt;/b&gt; — durable writes go through the consolidator&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;&lt;b&gt;Onboarding&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;locale, questionnaire scores&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;profile fields, strengths, challenges&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;&lt;b&gt;Pedagogical&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;mastery, current state, recommendations, enrolments&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;current state, recommendations, mastery&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;&lt;b&gt;Reflection&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;mastery, recent reflections&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;recent reflections&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;&lt;b&gt;Teacher Insights&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;progress, mastery, strengths, challenges, enrolments, wellbeing flags&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;&lt;b&gt;nothing&lt;/b&gt; — read-only&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FCF3F3&quot;&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;&lt;b&gt;Teacher Assistant&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;a wider slice — progress, mastery, goals, directives, reflections, description — but &lt;b&gt;never&lt;/b&gt; identity, &lt;b&gt;never&lt;/b&gt; raw mapping scores, &lt;b&gt;never&lt;/b&gt; the learner's private memory&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;&lt;b&gt;nothing&lt;/b&gt; — no AI write into a child's record&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;&lt;b&gt;Safety&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;locale only&lt;/td&gt;&lt;td style=&quot;border:1px solid #C6CED6;padding:5px&quot;&gt;wellbeing flags&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6CED6;verticalAlign=top;overflow=fill;fontSize=10" vertex="1" parent="41">
          <mxGeometry x="790" y="204" width="850" height="410" as="geometry" />
        </mxCell>

        <mxCell id="p3d2" value="&lt;b&gt;Why the teacher's assistant is denied the learner's memory&lt;/b&gt;&lt;br&gt;&lt;br&gt;It reads a wider slice than the insights agent, because it answers open questions about a class. Three exclusions are deliberate and load-bearing.&lt;br&gt;&lt;br&gt;&lt;b&gt;Identity&lt;/b&gt; — no personal detail reaches a model prompt. The assistant refers to learners by pseudonymous id and the client renders the real name.&lt;br&gt;&lt;b&gt;Raw instrument scores&lt;/b&gt; — not a teacher-facing artefact; the curated description carries the provenance instead.&lt;br&gt;&lt;b&gt;The learner's private memory&lt;/b&gt; — the companion only stays trustworthy to a child if it is not also a surveillance channel." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F5F1;strokeColor=#207A6B;strokeWidth=2.5;fontSize=11;fontColor=#12403A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="41">
          <mxGeometry x="790" y="634" width="850" height="180" as="geometry" />
        </mxCell>

        <mxCell id="p3d3" value="Access checks run before reporting, too: a teacher view that would be refused must not emit a 'viewed' event to the ministry." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#4A5568" vertex="1" parent="41">
          <mxGeometry x="790" y="830" width="850" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================ -->
  <!-- PAGE 4 — TARGET                                              -->
  <!-- ============================================================ -->
  <diagram name="4 · Target architecture" id="page-target">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="60" />
        <mxCell id="61" parent="60" />

        <mxCell id="p4t" value="Target architecture — where I would take it next" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1A202C" vertex="1" parent="61">
          <mxGeometry x="40" y="18" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p4s" value="Purple dashed is target state, not running today. A green tick marks what already exists and carries over unchanged. The order at the bottom right is deliberate: cheapest risk reduction first." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4A5568" vertex="1" parent="61">
          <mxGeometry x="40" y="52" width="1100" height="34" as="geometry" />
        </mxCell>

        <mxCell id="p4e1" value="&lt;b&gt;Azure Front Door&lt;/b&gt; — WAF, TLS, caching for static assets, single public entry point" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=11;fontColor=#3C2A6B;dashed=1" vertex="1" parent="61">
          <mxGeometry x="40" y="110" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4e2" value="&lt;b&gt;✓ APIM AI Gateway&lt;/b&gt; — exists today and stays the single control point for model access" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3EDFB;strokeColor=#2B6CB0;strokeWidth=2.5;fontSize=11;fontColor=#1A365D" vertex="1" parent="61">
          <mxGeometry x="640" y="110" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4e3" value="&lt;b&gt;Azure AI Content Safety&lt;/b&gt;&lt;br&gt;input + output filtering, jailbreak / prompt shields — in front of the model, behind the gateway" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;strokeWidth=2.5;fontSize=11;fontColor=#3C2A6B;dashed=1" vertex="1" parent="61">
          <mxGeometry x="1180" y="110" width="480" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p4c" value="AZURE CONTAINER APPS ENVIRONMENT — replaces the single App Service container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF8FF;strokeColor=#6B46C1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#6B46C1" vertex="1" parent="61">
          <mxGeometry x="40" y="210" width="1100" height="270" as="geometry" />
        </mxCell>
        <mxCell id="p4c1" value="&lt;b&gt;spark-api&lt;/b&gt;&lt;br&gt;FastAPI, request path only.&lt;br&gt;KEDA scales on concurrent HTTP requests.&lt;br&gt;Stateless — which is only true once sessions and the event bus move out." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=11;fontColor=#3C2A6B;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="61">
          <mxGeometry x="60" y="250" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4c2" value="&lt;b&gt;spark-workers&lt;/b&gt;&lt;br&gt;Manim rendering, ministry LRS delivery, weekly digests, explainer generation.&lt;br&gt;KEDA scales on queue depth, and scales to zero when idle." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=11;fontColor=#3C2A6B;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="61">
          <mxGeometry x="420" y="250" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4c3" value="&lt;b&gt;Why split them&lt;/b&gt;&lt;br&gt;A Manim render can take tens of seconds. Today it shares a process with a child waiting on a streamed reply. The split is about latency isolation as much as scale." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="61">
          <mxGeometry x="780" y="250" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4c4" value="&lt;b&gt;Azure Cache for Redis&lt;/b&gt;&lt;br&gt;sessions · SSE fan-out across replicas · trigger cooldowns and dedupe keys · presence.&lt;br&gt;&lt;b&gt;This is the unlock:&lt;/b&gt; everything stateful is in-process today, which is why the app runs on exactly one worker and warns at boot if you try otherwise." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;strokeWidth=2.5;fontSize=11;fontColor=#3C2A6B;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="61">
          <mxGeometry x="60" y="370" width="520" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p4c5" value="&lt;b&gt;Azure Service Bus&lt;/b&gt;&lt;br&gt;async queues for ministry reporting, renders and digests.&lt;br&gt;The publish seam already exists in one module, so this is a swap rather than a rewrite." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=11;fontColor=#3C2A6B;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="61">
          <mxGeometry x="600" y="370" width="520" height="94" as="geometry" />
        </mxCell>

        <mxCell id="p4d" value="&lt;b&gt;✓ Cosmos DB (Mongo API)&lt;/b&gt; — unchanged. What changes is that the JSON file fallback stops being a production code path: a database failure should fail the request and page someone, not write to local disk." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF6E3;strokeColor=#B7791F;fontSize=11;fontColor=#5F370E;align=left;spacingLeft=12;verticalAlign=middle" vertex="1" parent="61">
          <mxGeometry x="40" y="510" width="1100" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p4i" value="IDENTITY + SECRETS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF8FF;strokeColor=#6B46C1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#6B46C1" vertex="1" parent="61">
          <mxGeometry x="40" y="610" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4i1" value="&lt;b&gt;Key Vault&lt;/b&gt; — APIM subscription key, ministry LRS client secret, database connection string, token signing key. Rotation becomes an operation rather than a redeploy." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=11;fontColor=#3C2A6B;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="61">
          <mxGeometry x="60" y="650" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4i2" value="&lt;b&gt;Managed identity&lt;/b&gt; — the app authenticates to Key Vault, Cosmos, Service Bus and the registry with no stored credential at all." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=11;fontColor=#3C2A6B;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="61">
          <mxGeometry x="420" y="650" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4i3" value="&lt;b&gt;GitHub OIDC federated credentials&lt;/b&gt; — replaces the service-principal secret and the registry password held in repository secrets today. No long-lived credential anywhere in the pipeline." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=11;fontColor=#3C2A6B;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10" vertex="1" parent="61">
          <mxGeometry x="780" y="650" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p4p" value="PIPELINE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF8FF;strokeColor=#6B46C1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#6B46C1" vertex="1" parent="61">
          <mxGeometry x="40" y="800" width="1100" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4p1" value="&lt;b&gt;test gate&lt;/b&gt;&lt;br&gt;the 1,060 existing tests, 44 s" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=11;fontColor=#3C2A6B;dashed=1" vertex="1" parent="61">
          <mxGeometry x="60" y="850" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4p2" value="&lt;b&gt;✓ build → registry&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=11;fontColor=#1F2933" vertex="1" parent="61">
          <mxGeometry x="278" y="850" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4p3" value="&lt;b&gt;✓ deploy to dev&lt;/b&gt;&lt;br&gt;settings asserted first" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=11;fontColor=#1F2933" vertex="1" parent="61">
          <mxGeometry x="476" y="850" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4p4" value="&lt;b&gt;health poll + smoke&lt;/b&gt;&lt;br&gt;the admin service already does this" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3ECFB;strokeColor=#6B46C1;fontSize=11;fontColor=#3C2A6B;dashed=1" vertex="1" parent="61">
          <mxGeometry x="684" y="850" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4p5" value="&lt;b&gt;✓ manual promote&lt;/b&gt;&lt;br&gt;revision split / slot swap" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;fontSize=11;fontColor=#1F2933" vertex="1" parent="61">
          <mxGeometry x="902" y="850" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4pe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;" edge="1" parent="61" source="p4p1" target="p4p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4pe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;" edge="1" parent="61" source="p4p2" target="p4p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4pe3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;" edge="1" parent="61" source="p4p3" target="p4p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4pe4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8895A4;endArrow=block;endFill=1;" edge="1" parent="61" source="p4p4" target="p4p5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p4o" value="&lt;b&gt;Order I would actually do it in&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1 · Test gate in CI.&lt;/b&gt; An afternoon. The tests already exist and pass; the pattern already exists in the smaller service. Biggest risk reduction per hour of work in the whole list.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · Managed Content Safety.&lt;/b&gt; The users are children. What is there today is a solid first-party base layer, not a substitute for input and output filtering with jailbreak protection.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Key Vault, managed identity, GitHub OIDC.&lt;/b&gt; Removes every long-lived credential from the pipeline and the app settings.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 · Redis.&lt;/b&gt; Until sessions, presence and the event bus leave process memory, the service physically cannot run more than one replica. Everything else about scale is blocked behind this.&lt;br&gt;&lt;br&gt;&lt;b&gt;5 · Service Bus and the worker split.&lt;/b&gt; Gets rendering and ministry reporting off the request path.&lt;br&gt;&lt;br&gt;&lt;b&gt;6 · Container Apps with KEDA.&lt;/b&gt; Only worth doing after 4 and 5 — autoscaling a service that cannot run two replicas buys nothing.&lt;br&gt;&lt;br&gt;&lt;b&gt;7 · Retry with backoff at the gateway,&lt;/b&gt; so a transient provider failure stops degrading silently into a canned sentence.&lt;br&gt;&lt;br&gt;&lt;b&gt;Deliberately not on the list:&lt;/b&gt; a vector database. The content is a structured catalogue with stable ids; adding embeddings would add a moving part and lose precision." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E4C59;strokeWidth=2;fontSize=11;fontColor=#1F2933;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12" vertex="1" parent="61">
          <mxGeometry x="1180" y="210" width="480" height="740" as="geometry" />
        </mxCell>

        <mxCell id="p4ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B46C1;dashed=1;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0" edge="1" parent="61" source="p4e1" target="p4c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4ed2" value="every model call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2B6CB0;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=10;exitX=0.75;exitY=0;entryX=0.5;entryY=1" edge="1" parent="61" source="p4c" target="p4e2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4ed3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B46C1;dashed=1;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="61" source="p4e2" target="p4e3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4ed4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8895A4;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="61" source="p4c" target="p4d"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
