# Learning Game Lab worker — the SAME keys are the Container App env vars
# (infra/game-gen/main.bicep). Locally the worker also reads backend/.env.

# --- Copilot SDK ---
# Service token for GitHub Copilot (the vibe-coding-kids one). Empty locally =
# use the logged-in Copilot CLI (`gh auth login`).
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=claude-sonnet-5   # bake-off 2026-09-10: same judge scores as Opus 5 at a third of the cost and 30% faster
COPILOT_LOG_LEVEL=warning
# COPILOT_CLI_PATH=              (override; the SDK provisions its own runtime)
# Hard per-build cap in GitHub AI credits (1 credit = $0.01). 300 ≈ $3.
GAME_MAX_AI_CREDITS=300
GAME_SPARKS_PER_USD=100

# --- Jobs transport (mirrors backend/env.template) ---
GAME_JOBS_MODE=mongo
GAME_JOBS_QUEUE=game-jobs-dev
GAME_JOBS_SERVICEBUS_CONNECTION_STRING=
GAME_JOBS_SERVICEBUS_NAMESPACE=
GAME_JOBS_MAX_DELIVERY=3
GAME_WORKER_POLL_SECONDS=3
GAME_WORKER_LOG_LEVEL=INFO
# GAME_WORKER_ONCE=1             (drain the queue and exit)

# --- Storage + database (same values as the backend of the same environment) ---
GAMES_STORAGE=local
GAMES_BLOB_CONTAINER=games-dev
GAMES_STORAGE_ACCOUNT_URL=https://yuvi720blobstorage.blob.core.windows.net
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=yuvi720
SPARK_ENVIRONMENT=local
REDIS_CONNECTION_STRING=
# Realtime frames + bell reach the app through the Redis bridge; without Redis
# the worker's frames are local-only (the bell row is still written to Mongo).

# --- Plan/judge model via APIM (optional; default routes everything via Copilot) ---
APIM_BASE_URL=
APIM_SUBSCRIPTION_KEY=
APIM_API_VERSION=2024-10-21
