{
  "name": "yuvi-720-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:unity": "../scripts/build-unity-world.sh",
    "build:all": "npm run build:unity && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "test:companion-visuals": "node scripts/test-companion-visuals.mjs",
    "test:companion-visuals:headed": "node scripts/test-companion-visuals.mjs --headed",
    "test:companion-orchestration": "node scripts/test-companion-orchestration.mjs",
    "test:companion-orchestration:headed": "node scripts/test-companion-orchestration.mjs --headed",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:path": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@vitejs/plugin-react": "latest",
    "animejs": "^4.5.0",
    "katex": "^0.17.0",
    "mafs": "^0.21.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "motion": "^12.42.2",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.185.1",
    "playwright": "^1.61.1"
  }
}
