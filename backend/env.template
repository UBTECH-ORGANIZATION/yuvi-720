# yuvi-720 environment variables.
#
# LOCAL DEV:  copy this file to backend/.env (gitignored) and fill values.
#             server.py auto-loads backend/.env on startup.
# AZURE:      the SAME keys are set as App Service "Application settings"
#             (container env vars). No .env file ships inside the Docker image.
#
# The app runs WITHOUT any of these (AI features fall back to canned responses),
# but production should set the APIM + Mongo values below.

# --- Azure OpenAI via APIM gateway (reused from the shared cotrade APIM) ---
APIM_BASE_URL=https://apim-cotrade-prod.azure-api.net/openai
APIM_SUBSCRIPTION_KEY=your-apim-subscription-key
LLM_STRONG_DEPLOYMENT_NAME=gpt-5.4
LLM_MINI_DEPLOYMENT_NAME=gpt-5.4-mini
APIM_API_VERSION=2024-10-21

# Or Azure AI Foundry direct endpoint fallback
# AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project
# AZURE_AI_FOUNDRY_API_KEY=your-foundry-key

# --- Azure AI Speech (optional; Coach read-aloud uses browser fallback) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional custom/private endpoint. By default the regional REST endpoint is used.
# AZURE_SPEECH_ENDPOINT=https://your-region.tts.speech.microsoft.com/cognitiveservices/v1

# --- Database (Cosmos DB for MongoDB vCore) ---
# There are two clusters. `yuvi720-dev` is the one a laptop is allowed to use;
# `yuvi720` is production and its credentials live only where production runs.
# A non-production process that points at the production host refuses to start.
MONGODB_CONNECTION_STRING=mongodb+srv://user:pass@yuvi720-dev.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
MONGODB_DATABASE=yuvi720
# Names this deployment: local / dev / english / production. Also decides
# whether the production cluster may be opened at all.
SPARK_ENVIRONMENT=local
# Only to run with no database at all, on local JSON files. Without it, a
# missing MONGODB_CONNECTION_STRING is a startup error rather than a silent
# fallback that writes to the container filesystem.
# SPARK_STORAGE=json
# Deliberate, single-use exception for reaching production from elsewhere.
# SPARK_ALLOW_PRODUCTION_DB=1

# --- App / hosting ---
# Public-facing URL (used for absolute links / OAuth redirects if added later).
FRONTEND_URL=https://spark.yuvilab.ai
# Canonical backend origin used for signed xAPI and timing URLs. Override with
# https://dev.spark.yuvilab.ai in the Dev deployment slot.
#
# LOCAL DEV: Kata's servers relay content xAPI to PUBLIC_APP_URL/api/xapi — a
# localhost value is unreachable from Kata, so events never arrive and the coach
# stays on the first question. Expose the local backend with a public tunnel:
#     bash scripts/dev_tunnel.sh
# It sets PUBLIC_APP_URL to the tunnel URL here, then restores it on Ctrl+C.
PUBLIC_APP_URL=https://spark.yuvilab.ai
# Dedicated token-signing secret. Use a different slot-sticky value per environment.
SECRET_KEY=replace-with-a-long-random-secret

# The build the learner is running, set by the deploy pipeline (image tag /
# release number). Reported to the MoE LRS as the session `enter` extension
# `applicationVersion`. Left empty it is simply not reported — never guessed.
APP_VERSION=

# ---- Kata (CET) content platform — catalog + xAPI launcher ----
# Staging host: kata.cet.ac.il · key issued by CET. Catalog is authed by X-API-Key;
# the launcher relays content xAPI to our PUBLIC_APP_URL/api/xapi ingest.
KATA_BASE_URL=https://kata.cet.ac.il
KATA_API_KEY=
# Optional catalog/launcher HTTP timeout (seconds).
KATA_TIMEOUT_SECONDS=12
# `grouping→content-vendor`: the content SUPPLIER's ministry id, resolved per
# content from the catalog's `manufacture` field — no hand-maintained list.
# The ids are the ones published in spec v1.1 (16/08): מטח 10 · קמפוס 521 ·
# מתודיקה 310. Keys accept `vendor`, `vendor|subject` and `vendor|subject|grade`;
# the most specific one wins. Unset = the ministry's list below. An explicit {}
# means "none", which stops reporting rather than inventing an id.
LRS_CONTENT_VENDORS={"מטח": "10", "קמפוס": "521", "מתודיקה": "310"}

# Player hosts that cannot be rendered inside the lesson frame — the activity is
# offered in its own tab instead. Comma-separated; empty means "frame everything".
#
# learning.cet.ac.il is listed because CET's player looks for a CET SSO session
# that a 720 learner never has, then loops through auth.cet.ac.il/v2/logout →
# AccessMngApi/logout/timeout → itself, ~every 2.5s (verified 2026-08-02; its
# session cookies are SameSite=Lax, so no cross-site frame can ever hold them).
# Clear this entry once CET authenticates the player from the launch registration.
# The client also detects a reload loop on its own, so an unlisted host is still
# handled — this only spares the learner the first few seconds of strobing.
NON_EMBEDDABLE_PLAYER_HOSTS=learning.cet.ac.il
# Azure App Service reads WEBSITES_PORT to know which container port to route to.
WEBSITES_PORT=8000

# ---- Learning Coach operational controls ----
# Tool calling is opt-in because every call is a bounded extra model request.
# Enable it only after the target slot's tool registry and APIM telemetry are verified.
# Technical debug traces must stay off outside a short, authorized investigation.
COACH_TOOL_CALLING_ENABLED=true
COACH_DEBUG_TRACE_ENABLED=false

# --- Azure Communication Services (outbound email) ---
# Feeds BOTH the landing page contact form (POST /api/contact) and the 720
# campaign lead form (POST /api/leads). All three must be non-empty: `email.py`
# refuses to send with a partial config, and the routes turn that refusal into a
# 502, so a missing value here reads to the user as "the form is broken".
#
# These keys were once declared TWICE in this file, the second time with an empty
# connection string. Anything that populates App Service settings by walking the
# template took the LAST value and silently shipped an unconfigured mailer —
# which is exactly how production lost /api/leads. One block only.
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key
ACS_SENDER_ADDRESS=doNotReply@yuvilab.ai
# Comma-separated list of inboxes that receive contact form + campaign leads.
CONTACT_EMAILS=user1@yuvilab.ai,user2@yuvilab.ai

# ---- Support chat realtime ----
# Shared secret for the signed /internal/support/notify hook between this
# service and the admin console. Must be identical on both sides.
SUPPORT_INTERNAL_TOKEN=
# Base URL of the admin console, e.g. https://admin.spark.yuvilab.ai
SUPPORT_PEER_BASE_URL=

# ---- Support attachments (private Blob container "support-attachments") ----
# Prefer managed identity: set the account URL and grant Storage Blob Data
# Contributor. The connection string is a local-development fallback.
SUPPORT_STORAGE_ACCOUNT_URL=
SUPPORT_STORAGE_CONNECTION_STRING=

# ---- Performance monitoring (Application Insights) ----
# The single switch. Empty = no telemetry anywhere, including the browser; the
# app runs exactly as before. Set it on the App Service (per slot, so dev and
# production don't share a dashboard) to turn on request/dependency/exception
# tracking for the backend AND, via GET /api/telemetry/config, for the browser.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Optional: send browser telemetry to a *different* resource. Leave empty to
# share the backend's, which is what links a page view to the server request it
# caused into one end-to-end transaction.
APPLICATIONINSIGHTS_CONNECTION_STRING_BROWSER=
# Labels the telemetry so slots can be told apart. Defaults to the App Service
# slot name, then "local".
SPARK_ENVIRONMENT=
# Stamped by the deploy pipeline so a regression can be pinned to a build.
SPARK_RELEASE=
# Requests slower than this (ms) are logged as slow. Default 800.
SPARK_SLOW_REQUEST_MS=
# Percentage of browser sessions that report telemetry. 100 while we are
# hunting the slowness; lower it once a whole district is using the system.
SPARK_BROWSER_SAMPLING_PERCENT=
