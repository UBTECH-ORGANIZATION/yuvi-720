# yuvi-720 environment variables.
#
# LOCAL DEV:  copy this file to backend/.env (gitignored) and fill values.
#             server.py auto-loads backend/.env on startup.
# AZURE:      the SAME keys are set as App Service "Application settings"
#             (container env vars). No .env file ships inside the Docker image.
#
# The app runs WITHOUT any of these (AI features fall back to canned responses),
# but production should set the APIM + Mongo values below.

# --- Azure OpenAI via APIM gateway (reused from the shared cotrade APIM) ---
APIM_BASE_URL=https://apim-cotrade-prod.azure-api.net/openai
APIM_SUBSCRIPTION_KEY=your-apim-subscription-key
LLM_STRONG_DEPLOYMENT_NAME=gpt-5.4
LLM_MINI_DEPLOYMENT_NAME=gpt-5.4-mini
APIM_API_VERSION=2024-10-21

# Or Azure AI Foundry direct endpoint fallback
# AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project
# AZURE_AI_FOUNDRY_API_KEY=your-foundry-key

# --- Azure AI Speech (optional; Coach read-aloud uses browser fallback) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional custom/private endpoint. By default the regional REST endpoint is used.
# AZURE_SPEECH_ENDPOINT=https://your-region.tts.speech.microsoft.com/cognitiveservices/v1

# --- Database (Cosmos DB for MongoDB vCore) ---
MONGODB_CONNECTION_STRING=mongodb+srv://user:pass@yuvi720.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
MONGODB_DATABASE=yuvi720

# --- App / hosting ---
# Public-facing URL (used for absolute links / OAuth redirects if added later).
FRONTEND_URL=https://spark.yuvilab.ai
# Canonical backend origin used for signed xAPI and timing URLs. Override with
# https://dev.spark.yuvilab.ai in the Dev deployment slot.
#
# LOCAL DEV: Kata's servers relay content xAPI to PUBLIC_APP_URL/api/xapi — a
# localhost value is unreachable from Kata, so events never arrive and the coach
# stays on the first question. Expose the local backend with a public tunnel:
#     bash scripts/dev_tunnel.sh
# It sets PUBLIC_APP_URL to the tunnel URL here, then restores it on Ctrl+C.
PUBLIC_APP_URL=https://spark.yuvilab.ai
# Dedicated token-signing secret. Use a different slot-sticky value per environment.
SECRET_KEY=replace-with-a-long-random-secret

# ---- Kata (CET) content platform — catalog + xAPI launcher ----
# Staging host: kata.cet.ac.il · key issued by CET. Catalog is authed by X-API-Key;
# the launcher relays content xAPI to our PUBLIC_APP_URL/api/xapi ingest.
KATA_BASE_URL=https://kata.cet.ac.il
KATA_API_KEY=
# Optional catalog/launcher HTTP timeout (seconds).
KATA_TIMEOUT_SECONDS=12
# Player hosts that cannot be rendered inside the lesson frame — the activity is
# offered in its own tab instead. Comma-separated; empty means "frame everything".
#
# learning.cet.ac.il is listed because CET's player looks for a CET SSO session
# that a 720 learner never has, then loops through auth.cet.ac.il/v2/logout →
# AccessMngApi/logout/timeout → itself, ~every 2.5s (verified 2026-08-02; its
# session cookies are SameSite=Lax, so no cross-site frame can ever hold them).
# Clear this entry once CET authenticates the player from the launch registration.
# The client also detects a reload loop on its own, so an unlisted host is still
# handled — this only spares the learner the first few seconds of strobing.
NON_EMBEDDABLE_PLAYER_HOSTS=learning.cet.ac.il
# Azure App Service reads WEBSITES_PORT to know which container port to route to.
WEBSITES_PORT=8000

# --- Azure Communication Services (landing page contact form email) ---
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key
ACS_SENDER_ADDRESS=doNotReply@yourdomain.com
# Comma-separated list of inboxes that receive contact form submissions.
CONTACT_EMAILS=owner1@yourdomain.com,owner2@yourdomain.com

# ---- Azure Communication Services ----
AZURE_COMMUNICATION_CONNECTION_STRING=
ACS_SENDER_ADDRESS=doNotReply@yuvilab.ai
CONTACT_EMAILS=user1@yuvilab.ai,user2@yuvilab.ai

# ---- Support chat realtime ----
# Shared secret for the signed /internal/support/notify hook between this
# service and the admin console. Must be identical on both sides.
SUPPORT_INTERNAL_TOKEN=
# Base URL of the admin console, e.g. https://admin.spark.yuvilab.ai
SUPPORT_PEER_BASE_URL=

# ---- Support attachments (private Blob container "support-attachments") ----
# Prefer managed identity: set the account URL and grant Storage Blob Data
# Contributor. The connection string is a local-development fallback.
SUPPORT_STORAGE_ACCOUNT_URL=
SUPPORT_STORAGE_CONNECTION_STRING=
