# Standalone Yuvilab Spark administration service
ADMIN_ENV=development
ADMIN_PORT=9998
ADMIN_BASE_URL=http://localhost:9998
ADMIN_COOKIE_SECURE=false

# Keep false: administrators must authenticate with Google.
ADMIN_PUBLIC_ACCESS=false

# Required when Google auth is enabled. Generate a long random value.
ADMIN_SECRET_KEY=

# Used only when ADMIN_PUBLIC_ACCESS=false.
# Comma-separated, lowercase or mixed-case emails are accepted.
ADMIN_EMAILS=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Prefer a database credential with read-only access to ai_usage_events.
# Locally this must be the DEV cluster (yuvi720-dev). The production connection
# string belongs only in the App Service settings of the deployed admin app —
# the console prints the environment and database it opened at startup, and
# shows the same pair in the top bar, so a mistake here is visible.
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=yuvi720

# ---- Support chat realtime ----
# Shared secret for the signed /internal/support/notify hook between this
# console and the product backend. Must be identical on both sides.
SUPPORT_INTERNAL_TOKEN=
# Base URL of the product backend, e.g. https://spark.yuvilab.ai
SUPPORT_PEER_BASE_URL=

# ---- Support attachments (private Blob container "support-attachments") ----
# Prefer managed identity: set the account URL and grant Storage Blob Data
# Contributor. The connection string is a local-development fallback.
SUPPORT_STORAGE_ACCOUNT_URL=
SUPPORT_STORAGE_CONNECTION_STRING=
